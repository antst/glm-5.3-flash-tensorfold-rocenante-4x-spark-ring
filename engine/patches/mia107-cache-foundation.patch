+"""Serialized SSE writes with bounded, request-owned silence keepalives.
+
+The model stays on its existing request thread. The only added thread writes
+comments, and is stopped and joined before the response releases its socket.
+"""
+from __future__ import annotations
+
+import math
+import threading
+import time
+
+KEEPALIVE_S = 20.0
+WRITE_TIMEOUT_S = 5.0
+COMMENT = b": keepalive\n\n"
+
+
+class SSEWriter:
+    def __init__(self, handler, cancellation, *, interval=KEEPALIVE_S, write_timeout=WRITE_TIMEOUT_S):
+        if any(not math.isfinite(v) or v <= 0 for v in (interval, write_timeout)):
+            raise ValueError("SSE intervals must be finite and positive")
+        self.handler, self.cancellation = handler, cancellation
+        self.interval, self.write_timeout = interval, write_timeout
+        self.lock = threading.Lock()
+        self.stopped = threading.Event()
+        self.last_write = time.monotonic()
+        self.thread = threading.Thread(target=self._keepalive, name="tensorfold-sse-keepalive", daemon=True)
+        self.previous_timeout = None
+
+    def __enter__(self):
+        connection = self.handler.connection
+        self.previous_timeout = connection.gettimeout()
+        timeout = self.write_timeout if self.previous_timeout is None else min(self.previous_timeout, self.write_timeout)
+        connection.settimeout(timeout)
+        try:
+            self.thread.start()
+        except BaseException:
+            connection.settimeout(self.previous_timeout)
+            raise
+        return self
+
+    def _failed(self):
+        self.cancellation.cancel()
+        self.stopped.set()
+
+    def _write_locked(self, data, final=False):
+        if self.stopped.is_set() or self.cancellation.cancelled:
+            self.stopped.set()
+            return False
+        try:
+            self.handler.wfile.write(data)
+            self.handler.wfile.flush()
+            self.last_write = time.monotonic()
+            return True
+        except OSError:
+            self._failed()
+            return False
+        finally:
+            if final:
+                self.stopped.set()  # under the write lock: no heartbeat can follow DONE/error
+
+    def write(self, data, *, final=False):
+        with self.lock:
+            return self._write_locked(data, final)
+
+    def _keepalive(self):
+        try:
+            while not self.stopped.wait(max(0.001, self.interval - (time.monotonic() - self.last_write))):
+                with self.lock:
+                    if time.monotonic() - self.last_write >= self.interval:
+                        if not self._write_locked(COMMENT):
+                            return
+        except Exception:
+            self._failed()  # a background writer failure must cancel, never leave generation abandoned
+
+    def __exit__(self, exc_type, exc, tb):
+        self.stopped.set()
+        self.thread.join()  # socket writes have the bounded timeout installed above
+        try:
+            self.handler.connection.settimeout(self.previous_timeout)
+        except OSError:  # a disconnected socket may already have been closed
+            pass
