+"""Shared immutable token histories, with a disk-backed, bounded-cache directory.
+
+Each node adds at most 2048 int64 tokens to a prefix. Checkpoints retain only a
+root hash and length. Nodes and payloads are shared across turns and branches;
+checkpoint roots are committed before the checkpoint manifest is published.
+This module is stdlib-only and performs no model or CUDA operations.
+"""
+from __future__ import annotations
+
+from bisect import bisect_left
+from collections import OrderedDict
+from dataclasses import dataclass
+import hashlib
+import json
+import os
+from pathlib import Path
+import sqlite3
+import struct
+import sys
+import threading
+import time
+
+BLOCK = 2048
+EMPTY = bytes(32)
+
+
+def node_hash(parent: bytes, payload_hash: bytes, n: int) -> bytes:
+    return hashlib.sha256(b"TF-token-history-v1\0" + parent + payload_hash + struct.pack("<Q", n)).digest()
+
+
+@dataclass(frozen=True)
+class HistoryRef:
+    head: bytes
+    n: int
+
+    def to_json(self):
+        return {"head": self.head.hex(), "n": self.n}
+
+    @classmethod
+    def parse(cls, value):
+        if not isinstance(value, dict) or set(value) != {"head", "n"}:
+            raise ValueError("invalid token-history descriptor")
+        if type(value["n"]) is not int or value["n"] <= 0:
+            raise ValueError("invalid token-history length")
+        head = bytes.fromhex(value["head"])
+        if len(head) != 32:
+            raise ValueError("invalid token-history root")
+        return cls(head, value["n"])
+
+
+class PrefixMatcher:
+    """Temporary prefix fingerprints; retains no full history in the index."""
+    def __init__(self, parts):
+        self.parts = list(parts)  # (end position, node hash, parent hash, payload bytes)
+        self.ends = [p[0] for p in self.parts]
+        self.n = self.ends[-1] if self.ends else 0
+
+    @classmethod
+    def from_buffer(cls, values):
+        raw = memoryview(values).cast("B")
+        if len(raw) % 8:
+            raise ValueError("token history requires int64 values")
+        parts, parent = [], EMPTY
+        for start in range(0, len(raw), 8 * BLOCK):
+            data = bytes(raw[start:start + 8 * BLOCK])
+            end = (start + len(data)) // 8
+            head = node_hash(parent, hashlib.sha256(data).digest(), end)
+            parts.append((end, head, parent, data))
+            parent = head
+        return cls(parts)
+
+    def head_at(self, n):
+        if not 0 < n <= self.n:
+            return None
+        i = bisect_left(self.ends, n)
+        end, head, parent, data = self.parts[i]
+        if n == end:
+            return head
+        start = 0 if i == 0 else self.ends[i - 1]
+        return node_hash(parent, hashlib.sha256(data[:8 * (n - start)]).digest(), n)
+
+    def matches(self, ref):
+        return self.head_at(ref.n) == ref.head
+
+
+class TokenHistories:
+    def __init__(self, path, *, cache_kib=4096):
+        self.path = Path(path)
+        self.path.parent.mkdir(parents=True, exist_ok=True)
+        self.lock = threading.RLock()
+        self.db = sqlite3.connect(self.path, check_same_thread=False)
+        self.db.execute("PRAGMA journal_mode=WAL")
+        self.db.execute("PRAGMA synchronous=FULL")
+        self.db.execute("PRAGMA mmap_size=0")
+        self.db.execute(f"PRAGMA cache_size=-{int(cache_kib)}")
+        self.db.execute("PRAGMA wal_autocheckpoint=256")
+        self.db.executescript("""
+          CREATE TABLE IF NOT EXISTS payloads (hash BLOB PRIMARY KEY, data BLOB NOT NULL, refs INTEGER NOT NULL);
+          CREATE TABLE IF NOT EXISTS nodes (hash BLOB PRIMARY KEY, parent BLOB NOT NULL,
+            payload BLOB NOT NULL, n INTEGER NOT NULL, refs INTEGER NOT NULL);
+          CREATE TABLE IF NOT EXISTS roots (owner TEXT PRIMARY KEY, head BLOB NOT NULL, n INTEGER NOT NULL);
+        """)
+        self.db.commit()
+        fd = os.open(self.path.parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        self.written_payload_bytes = 0
+
+    def put(self, owner, values):
+        raw = memoryview(values).cast("B")
+        if not len(raw) or len(raw) % 8:
+            raise ValueError("token history requires nonempty int64 values")
+        parent, written = EMPTY, 0
+        with self.lock, self.db:
+            for start in range(0, len(raw), 8 * BLOCK):
+                data = bytes(raw[start:start + 8 * BLOCK])
+                n = (start + len(data)) // 8
+                ph = hashlib.sha256(data).digest()
+                head = node_hash(parent, ph, n)
+                existing = self.db.execute("SELECT parent,payload,n FROM nodes WHERE hash=?", (head,)).fetchone()
+                if existing is None:
+                    payload = self.db.execute("SELECT data FROM payloads WHERE hash=?", (ph,)).fetchone()
+                    if payload is None:
+                        self.db.execute("INSERT INTO payloads VALUES (?,?,0)", (ph, data))
+                        written += len(data)
+                    elif payload[0] != data:
+                        raise ValueError("token payload hash collision or corruption")
+                    self.db.execute("UPDATE payloads SET refs=refs+1 WHERE hash=?", (ph,))
+                    self.db.execute("INSERT INTO nodes VALUES (?,?,?,?,0)", (head, parent, ph, n))
+                    if parent != EMPTY:
+                        if self.db.execute("UPDATE nodes SET refs=refs+1 WHERE hash=?", (parent,)).rowcount != 1:
+                            raise ValueError("missing token-history parent")
+                elif existing != (parent, ph, n):
+                    raise ValueError("token-history node identity mismatch")
+                parent = head
+            ref = HistoryRef(parent, len(raw) // 8)
+            old = self.db.execute("SELECT head,n FROM roots WHERE owner=?", (owner,)).fetchone()
+            if old != (ref.head, ref.n):
+                self.db.execute("UPDATE nodes SET refs=refs+1 WHERE hash=?", (ref.head,))
+                self.db.execute("INSERT OR REPLACE INTO roots VALUES (?,?,?)", (owner, ref.head, ref.n))
+                if old is not None:
+                    self._drop_reference(old[0])
+        self.written_payload_bytes += written
+        return ref
+
+    def bind(self, owner, descriptor):
+        ref = HistoryRef.parse(descriptor)
+        with self.lock:
+            row = self.db.execute("SELECT head,n FROM roots WHERE owner=?", (owner,)).fetchone()
+            if row != (ref.head, ref.n):
+                raise ValueError("checkpoint/token-history root mismatch")
+        return ref
+
+    def _parts(self, ref):
+        """Lock held; validate the chain before exposing token values."""
+        parts, head, end = [], ref.head, ref.n
+        while head != EMPTY:
+            row = self.db.execute("SELECT parent,payload,n FROM nodes WHERE hash=?", (head,)).fetchone()
+            if row is None or row[2] != end:
+                raise ValueError("missing or inconsistent token-history node")
+            parent, ph, n = row
+            payload = self.db.execute("SELECT data FROM payloads WHERE hash=?", (ph,)).fetchone()
+            if payload is None:
+                raise ValueError("missing token-history payload")
+            data = payload[0]
+            count = (n - 1) % BLOCK + 1
+            if (len(data) != 8 * count or hashlib.sha256(data).digest() != ph
+                    or node_hash(parent, ph, n) != head):
+                raise ValueError("corrupt token-history payload")
+            parts.append((n, head, parent, data))
+            end -= count
+            head = parent
+            if end < 0 or (head == EMPTY) != (end == 0):
+                raise ValueError("invalid token-history chain geometry")
+        parts.reverse()
+        return parts
+
+    def matcher(self, ref):
+        with self.lock:
+            return PrefixMatcher(self._parts(ref))
+
+    def read(self, ref):
+        with self.lock:
+            return b"".join(row[3] for row in self._parts(ref))
+
+    def digest(self, ref):
+        h = hashlib.sha256()
+        with self.lock:
+            for row in self._parts(ref):
+                h.update(row[3])
+        return h.hexdigest()
+
+    def _drop_reference(self, head):
+        """Transaction/lock held. Reclaim only nodes no child or checkpoint uses."""
+        while head != EMPTY:
+            row = self.db.execute("SELECT parent,payload,refs FROM nodes WHERE hash=?", (head,)).fetchone()
+            if row is None or row[2] < 1:
+                raise ValueError("token-history reference underflow")
+            parent, ph, refs = row
+            if refs > 1:
+                self.db.execute("UPDATE nodes SET refs=refs-1 WHERE hash=?", (head,))
+                return
+            self.db.execute("DELETE FROM nodes WHERE hash=?", (head,))
+            self.db.execute("UPDATE payloads SET refs=refs-1 WHERE hash=?", (ph,))
+            self.db.execute("DELETE FROM payloads WHERE hash=? AND refs=0", (ph,))
+            head = parent
+
+    def remove(self, owner):
+        with self.lock, self.db:
+            row = self.db.execute("SELECT head FROM roots WHERE owner=?", (owner,)).fetchone()
+            if row is not None:
+                self.db.execute("DELETE FROM roots WHERE owner=?", (owner,))
+                self._drop_reference(row[0])
+
+    def reconcile(self, owners):
+        """After validating checkpoint manifests, discard pre-publication orphans."""
+        wanted = set(owners)
+        with self.lock:
+            old = [r[0] for r in self.db.execute("SELECT owner FROM roots")]
+        for owner in old:
+            if owner not in wanted:
+                self.remove(owner)
+
+    def info(self):
+        with self.lock:
+            payloads, size = self.db.execute("SELECT count(*),coalesce(sum(length(data)),0) FROM payloads").fetchone()
+            nodes = self.db.execute("SELECT count(*) FROM nodes").fetchone()[0]
+            roots, logical = self.db.execute("SELECT count(*),coalesce(sum(n),0)*8 FROM roots").fetchone()
+            pages = self.db.execute("PRAGMA page_count").fetchone()[0]
+            free = self.db.execute("PRAGMA freelist_count").fetchone()[0]
+            page_size = self.db.execute("PRAGMA page_size").fetchone()[0]
+            return {"payloads": payloads, "nodes": nodes, "roots": roots,
+                    "payload_bytes": size, "logical_token_bytes": logical,
+                    "stored_bytes": (pages - free) * page_size,
+                    "new_payload_bytes": self.written_payload_bytes,
+                    "sqlite_cache_cap_bytes": abs(self.db.execute("PRAGMA cache_size").fetchone()[0]) * 1024}
+
+    def storage_bytes(self):
+        """Allocated live DB pages; free pages can be reused without disk growth."""
+        with self.lock:
+            pages = self.db.execute("PRAGMA page_count").fetchone()[0]
+            free = self.db.execute("PRAGMA freelist_count").fetchone()[0]
+            return (pages - free) * self.db.execute("PRAGMA page_size").fetchone()[0]
+
+    def close(self):
+        with self.lock:
+            self.db.execute("PRAGMA wal_checkpoint(TRUNCATE)")
+            self.db.close()
+
+
+class AccessTimes:
+    """Coalesced checkpoint recency; no disk writes on request/cache-hit paths.
+
+    The writer flushes changed timestamps in one transaction every two hours.
+    A clean shutdown forces a flush. An abrupt exit can lose recent access
+    timestamps, but never checkpoint/KV data. RAM decisions use exact live times.
+    """
+    INTERVAL = 2 * 60 * 60
+
+    def __init__(self, path, *, clock=time.monotonic):
+        self.clock = clock
+        self.lock = threading.RLock()
+        self.io_lock = threading.Lock()
+        self.db = sqlite3.connect(path, check_same_thread=False)
+        self.db.execute('PRAGMA journal_mode=WAL')
+        self.db.execute('PRAGMA synchronous=FULL')
+        self.db.execute('PRAGMA mmap_size=0')
+        self.db.execute('PRAGMA cache_size=-512')
+        self.db.execute('CREATE TABLE IF NOT EXISTS access_times (key TEXT PRIMARY KEY, used REAL NOT NULL)')
+        self.db.commit()
+        fd = os.open(Path(path).parent, os.O_RDONLY | os.O_DIRECTORY)
+        try:
+            os.fsync(fd)
+        finally:
+            os.close(fd)
+        self.dirty = {}
+        self.persisted = {row[0] for row in self.db.execute('SELECT key FROM access_times')}
+        self.inflight = set()
+        self.last_flush = clock()
+        self.last_attempt = None
+        self.flushes = self.flushed_entries = self.hits = self.errors = 0
+        self.last_error = None
+
+    def saved(self, key, fallback):
+        with self.io_lock:
+            row = self.db.execute('SELECT used FROM access_times WHERE key=?', (key,)).fetchone()
+        return max(fallback, row[0]) if row is not None else fallback
+
+    def mark(self, key, used):
+        with self.lock:
+            previous = self.dirty.get(key)
+            self.dirty[key] = max(used, previous) if previous is not None else used
+            self.hits += 1
+
+    def forget(self, key):
+        with self.lock:
+            if key in self.persisted or key in self.inflight:
+                self.dirty[key] = None
+            else:
+                self.dirty.pop(key, None)
+
+    def reconcile(self, valid):
+        """Recovery discards access records whose checkpoint no longer exists."""
+        wanted = set(valid)
+        with self.io_lock:
+            gone = [(row[0],) for row in self.db.execute('SELECT key FROM access_times') if row[0] not in wanted]
+            if gone:
+                with self.db:
+                    self.db.executemany('DELETE FROM access_times WHERE key=?', gone)
+        with self.lock:
+            self.persisted.difference_update(row[0] for row in gone)
+
+    def _persist(self, batch):
+        with self.io_lock, self.db:
+            updates = [(key, used) for key, used in batch.items() if used is not None]
+            deletes = [(key,) for key, used in batch.items() if used is None]
+            self.db.executemany('INSERT INTO access_times VALUES (?,?) ON CONFLICT(key) DO UPDATE SET used=max(used,excluded.used)', updates)
+            self.db.executemany('DELETE FROM access_times WHERE key=?', deletes)
+
+    def flush(self, *, force=False):
+        now = self.clock()
+        with self.lock:
+            if not self.dirty:
+                return True
+            if not force and (now - self.last_flush < self.INTERVAL or
+                              (self.last_attempt is not None and now - self.last_attempt < 60)):
+                return True
+            batch = dict(self.dirty)
+            self.inflight.update(batch)
+            self.last_attempt = now
+        try:
+            self._persist(batch)
+        except (OSError, sqlite3.Error) as exc:
+            with self.lock:
+                self.errors += 1
+                self.last_error = repr(exc)[:512]
+                self.inflight.difference_update(batch)
+            return False
+        with self.lock:
+            for key, used in batch.items():
+                if used is None:
+                    self.persisted.discard(key)
+                else:
+                    self.persisted.add(key)
+                if key in self.dirty and self.dirty[key] == used:
+                    del self.dirty[key]
+            self.inflight.difference_update(batch)
+            self.last_flush = now
+            self.flushes += 1
+            self.flushed_entries += len(batch)
+            self.last_error = None
+        return True
+
+    def info(self):
+        with self.lock:
+            return {'flush_interval_s': self.INTERVAL, 'dirty_entries': len(self.dirty),
+                    'hits': self.hits, 'flushes': self.flushes,
+                    'flushed_entries': self.flushed_entries, 'flush_errors': self.errors,
+                    'last_error': self.last_error, 'kv_rewrites': 0}
+
