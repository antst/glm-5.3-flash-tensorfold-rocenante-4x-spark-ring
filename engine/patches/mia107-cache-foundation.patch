+class ManifestCache:
+    """A byte-bounded RAM window over complete checkpoint manifests on NVMe."""
+    def __init__(self, directory, *, cap_bytes=4 << 20, max_file_bytes=2 << 20):
+        self.directory = Path(directory)
+        self.cap_bytes, self.max_file_bytes = cap_bytes, max_file_bytes
+        self.rows = OrderedDict()
+        self.bytes = 0
+        self.lock = threading.RLock()
+
+    def get(self, key):
+        with self.lock:
+            if key in self.rows:
+                row = self.rows.pop(key); self.rows[key] = row
+                return row[0]
+            path = self.directory / (key + ".json")
+            with path.open("rb") as fh:
+                raw = fh.read(self.max_file_bytes + 1)
+            if len(raw) > self.max_file_bytes:
+                raise ValueError("checkpoint manifest exceeds cache parser bound")
+            value = json.loads(raw)
+            size = object_bytes(value)
+            if size <= self.cap_bytes:
+                while self.rows and self.bytes + size > self.cap_bytes:
+                    _, (_, old_size) = self.rows.popitem(last=False)
+                    self.bytes -= old_size
+                self.rows[key] = (value, size); self.bytes += size
+            return value
+
+    def forget(self, key):
+        with self.lock:
+            row = self.rows.pop(key, None)
+            if row is not None:
+                self.bytes -= row[1]
