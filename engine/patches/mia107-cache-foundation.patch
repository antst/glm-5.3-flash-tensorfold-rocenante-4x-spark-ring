+"""Bound unused CUDA reservations at explicit serving boundaries.
+
+The decoder schedules the boundary on every rank. This module never performs a
+collective, evicts a model/cache object, resets peaks, or changes graph pools.
+"""
+from __future__ import annotations
+
+import math
+import time
+from dataclasses import dataclass
+
+GIB = 1 << 30
+WIRE_FIELDS = (
+    "allocated_bytes", "reserved_bytes", "active_bytes", "inactive_split_bytes",
+    "peak_allocated_bytes", "peak_reserved_bytes", "checks", "reclaims",
+    "released_bytes", "last_released_bytes", "last_duration_us", "errors",
+    "error_code", "last_before_bytes", "last_after_bytes", "last_unused_bytes", "retry_pending",
+)
+
+
+@dataclass(frozen=True)
+class ReclaimPolicy:
+    unused_bytes: int = 4 * GIB
+    inspect_s: float = 5.0
+    cooldown_s: float = 30.0
+    growth_bytes: int = 512 << 20
+
+    def __post_init__(self):
+        for name in ("unused_bytes", "growth_bytes"):
+            if type(getattr(self, name)) is not int or getattr(self, name) <= 0:
+                raise ValueError(f"{name} must be a positive integer")
+        for name in ("inspect_s", "cooldown_s"):
+            value = getattr(self, name)
+            if not math.isfinite(value) or value <= 0:
+                raise ValueError(f"{name} must be finite and positive")
+
+
+def pack_report(report):
+    """The control transport uses int32; preserve byte counters exactly in base2^31."""
+    out = []
+    for name in WIRE_FIELDS:
+        value = report[name]
+        if type(value) is not int or not 0 <= value < 1 << 62:
+            raise ValueError(f"invalid allocator counter: {name}")
+        out.extend((value & ((1 << 31) - 1), value >> 31))
+    return out
+
+
+def unpack_report(words):
+    if len(words) != 2 * len(WIRE_FIELDS) or any(type(v) is not int or not 0 <= v < 1 << 31 for v in words):
+        raise ValueError("invalid allocator report")
+    out = {name: words[2 * i] + (words[2 * i + 1] << 31) for i, name in enumerate(WIRE_FIELDS)}
+    if not (out["allocated_bytes"] <= out["active_bytes"] <= out["reserved_bytes"]
+            and out["inactive_split_bytes"] <= out["reserved_bytes"] - out["allocated_bytes"]
+            and out["peak_allocated_bytes"] >= out["allocated_bytes"]
+            and out["peak_reserved_bytes"] >= out["reserved_bytes"]
+            and out["retry_pending"] in (0, 1)):
+        raise ValueError("inconsistent allocator report")
+    return out
+
+
+class AllocatorReclaimer:
+    def __init__(self, cuda, device, *, policy=None, clock=time.monotonic):
+        self.cuda, self.device, self.clock = cuda, device, clock
+        self.policy = policy or ReclaimPolicy()
+        self.enabled = str(device).split(":")[0] == "cuda"
+        self.next_check = 0.0
+        self.last_attempt = -math.inf
+        self.post_unused = None
+        self.was_idle = False
+        self.last_error = None
+        self.values = dict.fromkeys(WIRE_FIELDS, 0)
+
+    def request(self):
+        # An eviction can request an earlier inspection, never an eager trim.
+        self.next_check = min(self.next_check, self.clock() + self.policy.inspect_s)
+
+    def note_activity(self):
+        # A request may start AND finish between two finish() calls.
+        self.was_idle = False
+
+    def due(self, *, idle):
+        transition = idle and not self.was_idle
+        self.was_idle = idle
+        return self.enabled and (transition or self.clock() >= self.next_check)
+
+    def _sample(self):
+        stats = self.cuda.memory_stats(self.device)
+        keys = {
+            "allocated_bytes": "allocated_bytes.all.current",
+            "reserved_bytes": "reserved_bytes.all.current",
+            "active_bytes": "active_bytes.all.current",
+            "inactive_split_bytes": "inactive_split_bytes.all.current",
+            "peak_allocated_bytes": "allocated_bytes.all.peak",
+            "peak_reserved_bytes": "reserved_bytes.all.peak",
+        }
+        sample = {name: stats[key] for name, key in keys.items()}
+        if any(type(v) is not int or not 0 <= v < 1 << 62 for v in sample.values()):
+            raise ValueError("allocator returned invalid counters")
+        a, r, active = sample["allocated_bytes"], sample["reserved_bytes"], sample["active_bytes"]
+        if not (a <= active <= r and sample["inactive_split_bytes"] <= r - a
+                and sample["peak_allocated_bytes"] >= a and sample["peak_reserved_bytes"] >= r):
+            raise ValueError("allocator returned inconsistent counters")
+        return sample
+
+    def inspect(self):
+        """Called ONLY by the decoder's ordered engine-thread maintenance op.
+
+        All exceptions become telemetry so peers still enter their one common
+        report collective. A successful trim never discards live tensors.
+        """
+        now = self.clock()
+        self.next_check = now + self.policy.inspect_s
+        self.values["checks"] += 1
+        self.values["retry_pending"] = 0
+        if not self.enabled:
+            return pack_report(self.values)
+        stage, started = 1, None
+        try:
+            sample = self._sample()
+            self.values.update(sample)
+            self.values["error_code"] = 0
+            self.last_error = None
+            unused = sample["reserved_bytes"] - sample["active_bytes"]
+            if unused < self.policy.unused_bytes:
+                return pack_report(self.values)
+            if self.post_unused is not None and unused < self.post_unused + self.policy.growth_bytes:
+                return pack_report(self.values)
+            if now - self.last_attempt < self.policy.cooldown_s:
+                self.values["retry_pending"] = 1
+                return pack_report(self.values)
+            # Record an attempt before calls that can fail; failure must not
+            # cause an expensive retry on every serving iteration.
+            self.last_attempt = now
+            started = self.clock()
+            stage = 2
+            self.cuda.synchronize(self.device)
+            before = self._sample()
+            self.values.update(before)
+            if before["reserved_bytes"] - before["active_bytes"] >= self.policy.unused_bytes:
+                self.values["last_before_bytes"] = before["reserved_bytes"]
+                stage = 3
+                self.cuda.empty_cache()
+                stage = 4
+                after = self._sample()
+                self.values.update(after)
+                released = max(0, before["reserved_bytes"] - after["reserved_bytes"])
+                self.values["reclaims"] += 1
+                self.values["released_bytes"] += released
+                self.values["last_released_bytes"] = released
+                self.values["last_after_bytes"] = after["reserved_bytes"]
+                self.post_unused = after["reserved_bytes"] - after["active_bytes"]
+                self.values["last_unused_bytes"] = self.post_unused
+        except Exception as exc:
+            self.values["errors"] += 1
+            self.values["error_code"] = stage
+            self.values["retry_pending"] = 1
+            self.last_error = f"{type(exc).__name__}: {exc}"[:256]
+        finally:
+            if started is not None:
+                self.values["last_duration_us"] = max(0, round((self.clock() - started) * 1e6))
+        return pack_report(self.values)
