+    with prof.timed("dsa: own front"):
+        if n:
+            if done != (lo, hi):
+                dsa_front(layer, w, b, lo, hi)
+            if index is not None:
+                mm(b, b.normed[lo:hi], ix.kw, b.xs[lo:hi], b.ikr[lo:hi])
+                glue.router(b.normed[lo:hi], ix.gate, b.igr[lo:hi])
