+class _History:
+    """A running hash of a conversation's message shapes (role, text stripped as the template renders it, calls;
+    no ids or reasoning), each length-prefixed: the key of calls after any prefix costs one copy of the hash."""
+
+    def __init__(self) -> None:
+        self.hash = hashlib.sha256(b"tf-kept-reasoning-v2\0")
+
+    def add(self, m: Any) -> None:
+        if not isinstance(m, dict):
+            return
+        entry = [str(m.get("role") or ""), _text(m.get("content")).strip()]
+        if m.get("role") == "assistant" and m.get("tool_calls"):
