+# Version 2 is deliberately incompatible with token-only PR124 points.
+FORMAT = "tensorfold-cuda-spill-blocks-generation-2"
+HOST_MIB = 256                 # pending small tensors/IDs/metadata, separate from preallocated row rings
+SMALL_IO_BYTES = 1 << 20       # one reusable aligned direct-write buffer
+MAX_MANIFEST_BYTES = 2 << 20   # recovery refuses unbounded/corrupt metadata files
+RESULT_LIMIT = 4096            # bounded local refusal/failure receipts; committed metadata lives in index
+READERS = 8                    # blocks read at once on a load (cold NVMe reads scale with the reads in flight)
+READ_BLOCKS = 16               # TF_GLM_SPILL_READ_BLOCKS: blocks loads read ahead into pinned slots (GLM on two
+                               # Sparks: 12.1 MiB a block; spill.preallocate's read buffers hold the first ten, the rest
+                               # comes out of the pool, about 14k tokens at PARALLEL=4; 9 costs it nothing): a slot is
+                               # free again only once the engine copied it out, so beside a decoding stream a load moves
+                               # at most this many a round (pin_read_ahead)
+STAGE_MIB = 256                # TF_GLM_SPILL_STAGE_MIB: the pinned ring writes go through (at least two blocks)
+
+
+def read_blocks() -> int:
+    """TF_GLM_SPILL_READ_BLOCKS: the blocks a load reads ahead into (at least one a reader thread)."""
+
+    return max(READERS, _count("TF_GLM_SPILL_READ_BLOCKS", READ_BLOCKS, "blocks"))
+
+
+def pin_read_ahead(block_bytes: int) -> int:
+    """The engine, before it sizes its pool from the memory left: room for ``read_blocks()`` blocks of ``block_bytes``
+    (the engine's bytes a pool block, at least a stored block's) read ahead. ``spill.preallocate``'s read buffers,
+    pinned before the engine read its free memory, hold the first of them; the rest is pinned now in pieces of a power
+    of two bytes, at most ``spill.CHUNK`` each: torch's pinned allocator rounds every allocation up to a power of two,
+    so a 12.1 MiB slot alone would hold 16 MiB, and eleven in one allocation 256 MiB. ``ring`` carves every whole
+    stored block out of them. The bytes pinned now, which the pool pays for (the preallocated ones came out of the
+    margin, as the write buffers do)."""
+
+    per = _up(block_bytes)
+    bufs = _sp._PINNED.setdefault("read", [])
+    want = read_blocks() * per - sum(b.numel() for b in bufs)
+    pin = torch.cuda.is_available()
+    took = 0
+    while want > 0:
+        size = 1 << (max(min(want, _sp.CHUNK), per) - 1).bit_length()
+        bufs.append(torch.empty(size, dtype=torch.uint8, pin_memory=pin))
+        took += size
+        want -= size
+    return took
+
+
+def _count(name: str, default: int, unit: str) -> int:
+    raw = str(os.environ.get(name, "") or "").strip() or str(default)
+    try:
+        n = int(raw)
+    except ValueError:
+        n = 0
+    if n < 1:
+        raise ValueError(f"{name}: whole {unit} >= 1, not {raw!r}")
+    return n
+PUMP_BLOCKS = 4                # at most this many blocks a pump (one call between two rounds, on the engine loop)
+BACKLOG = 16 << 30             # bytes of rows waiting to be written past which a new state is not queued
+TURNS = 4                      # newest states kept on a conversation's path; older turns go once a newer one is written
+LOAD_WAIT_S = 60.0             # a read of a point still being written waits this long for it
+
+
+def _up(x: int) -> int:
+    return -(-x // _sp.ALIGN) * _sp.ALIGN
+
+
+def _host(t: torch.Tensor) -> torch.Tensor:
+    """``t`` on the host, into touched pages (a copy from the GPU into fresh pageable memory faults every page in on
+    the way: ~0.1 GiB/s against ~35 GiB/s into touched pages, on the engine loop)."""
+
+    if t.device.type == "cpu":
+        return t.clone(memory_format=torch.contiguous_format)
+    out = torch.empty(t.shape, dtype=t.dtype, device="cpu")
+    if out.numel():
+        out.view(-1).view(torch.uint8).fill_(0)
+    out.copy_(t)
+    return out.contiguous()
+
+
+def _crc(mv) -> int:
+    return zlib.crc32(mv)
+
+
+def _digest(mv) -> bytes:
+    return hashlib.blake2b(mv, digest_size=16).digest()
+
+
+def fork(lineage: str, name: str, at: int) -> str:
+    """The lineage of a request that resumed from a state of ``lineage`` at token ``at`` and computes its own rows from
+    there: the same names for the blocks before ``at``, its own from the block holding ``at`` on."""
+
+    return f"{lineage}|{name}@{int(at)}"
+
+
+def _segments(lineage: str) -> tuple[bytes, list[tuple[int, bytes]]]:
+    head, *rest = (lineage or "").split("|")
+    forks = []
+    for part in rest:
+        name, _, at = part.rpartition("@")
+        forks.append((int(at), f"|{name}@{at}".encode()))
+    return head.encode(), forks
+
+
+def block_hashes(ids: np.ndarray, block: int, lineage: str = "") -> list[tuple[int, int, str]]:
+    """(start, end, name) of each block of ``ids``: whole blocks, then the tail [k * block, n) if any. A name covers
+    the lineage (its first computation, then each fork that holds or precedes the block) and every id up to its
+    block's end (chained), the tail's also its length, so equal names mean equal prefixes of one computation."""
+
+    h, forks = _segments(lineage)
+    out, n = [], len(ids)
+    a = np.asarray(ids, dtype=np.int64)
+    for s in range(0, n, block):
+        e = min(n, s + block)
+        salt = b"".join(f for at, f in forks if s <= at < e)
+        d = hashlib.sha256(h + salt + a[s:e].tobytes() + (b"" if e - s == block else str(e).encode()))
+        out.append((s, e, d.hexdigest()[:32]))
+        if e - s == block:
+            h = d.digest()
+    return out
+
+
+def point_key(ids: Sequence[int]) -> str:
+    """A state's name: its ids alone (whichever computation), 16 hex digits and its length."""
+
+    a = np.asarray(ids, dtype=np.int64)
+    return f"{hashlib.sha256(a.tobytes()).hexdigest()[:16]}-{len(a)}"
+
+
+def _generation(generation: str) -> str:
+    if not isinstance(generation, str) or not generation or len(generation) > 160:
+        raise ValueError("a caller-supplied shared immutable generation (1..160 characters) is required")
+    if not generation.isascii() or any(c not in "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-" for c in generation):
+        raise ValueError("generation must use ASCII letters, digits, underscore or hyphen")
+    return generation
+
+
+def snapshot_key_from_token(token_key: str, generation: str) -> str:
+    """Exact disk identity: token identity plus caller-agreed computation generation.
+
+    The caller must assign generation through ordered all-rank control, and must never
+    reuse it for a different computation. This layer never creates rank-local epochs.
+    """
+    _generation(generation)
+    # Validate the token key as well as avoiding path characters.
+    h, n = token_key.split("-")
+    if len(h) != 16 or int(n) < 0 or any(c not in "0123456789abcdef" for c in h):
+        raise ValueError("invalid token key")
+    return token_key + "~" + hashlib.sha256(generation.encode("ascii")).hexdigest()[:32]
+
+
+def snapshot_key(ids: Sequence[int], generation: str) -> str:
+    return snapshot_key_from_token(point_key(ids), generation)
+
+
+class Backpressure(RuntimeError):
+    """A destructive pool mutation must wait for finite-ring staging readiness."""
+
+
+def _state_bytes(items: list) -> int:
+    seen = set()
+    total = 0
+    for _, tensor in items:
+        storage = tensor.untyped_storage()
+        key = (str(tensor.device), storage.data_ptr(), storage.nbytes())
+        if key not in seen:
+            seen.add(key)
+            total += storage.nbytes()
+    return total
+
+
+def key_ints(key: str) -> list[int]:
+    """A key as three int32s for an op payload."""
+
+    h, n = key.split("-")
+    v = int(h, 16)
+    hi, lo = (v >> 32) & 0xFFFFFFFF, v & 0xFFFFFFFF
+    return [hi - (1 << 32) if hi >= 1 << 31 else hi, lo - (1 << 32) if lo >= 1 << 31 else lo, int(n)]
+
+
+def ints_key(hi: int, lo: int, n: int) -> str:
+    return f"{((hi & 0xFFFFFFFF) << 32) | (lo & 0xFFFFFFFF):016x}-{n}"
+
+
+def _rows(p, s: int, e: int) -> tuple[int, int]:
+    """Rows of plane ``p`` (relative to an extent's base) that tokens [s, e) occupy: every row holding one of them,
+    rounded up (a row still filling at a state's end holds its tokens so far), never the row past them."""
+
+    return s // p.div, -(-e // p.div)
+
+
+def _span_bytes(planes, s: int, e: int) -> int:
+    out = 0
+    for p in planes:
+        a, b = _rows(p, s, e)
+        out += (b - a) * p.tensor[0].numel() * p.tensor.element_size()
+    return out
+
+
+class Corrupt(Exception):
+    """A file that does not match its point (a CRC-32, a size): the read fails, the point goes."""
+
+
+# -- small files -----------------------------------------------------------------------------------------------------
+def _fsync_dir(path) -> None:
+    fd = os.open(path, os.O_RDONLY)
+    try:
+        os.fsync(fd)
+    finally:
+        os.close(fd)
+
+
+def _small_parts(items: list, layer: dict) -> list:
+    """A small state as a safetensors file (``spill.encode``'s items and layer, no pickle): its pieces in order, the
+    header then each tensor's bytes (views of the host tensors: nothing copied)."""
+
+    header, _ = _sp._header(items, {"format": FORMAT, "layer": json.dumps(layer)})
+    return [memoryview(header)] + [memoryview(t.contiguous().view(-1).view(torch.uint8).numpy()) for _, t in items
+                                   if t.numel()]
+
+
+def _small_read(raw: bytearray, classes: Sequence[str]) -> Any:
+    """A small state from its file's bytes: its tensors are views of ``raw`` (no copy; the caller keeps ``raw``)."""
+
+    header, at = _sp._parse_header(bytes(raw[:8 + struct.unpack("<Q", raw[:8])[0]]))
+    meta = header.get("__metadata__") or {}
+    if meta.get("format") != FORMAT:
+        raise Corrupt("a small state of another format")
+    tensors = {}
+    for name, d in header.items():
+        if name == "__metadata__":
+            continue
+        a, b = d["data_offsets"]
+        dt = _sp._TD[d["dtype"]]
+        if b > a:
+            tensors[name] = torch.frombuffer(raw, dtype=torch.uint8, count=b - a, offset=at + a).view(dt).reshape(
+                d["shape"])
+        else:
+            tensors[name] = torch.empty(d["shape"], dtype=dt)
+    return _sp.decode(json.loads(meta["layer"]), tensors, classes)
+
+
+def _aligned_buffer(n: int) -> np.ndarray:
+    """``n`` bytes (rounded up to 4 KiB) at a 4 KiB-aligned address: what O_DIRECT reads and writes."""
+
+    raw = np.empty(_up(n) + _sp.ALIGN, dtype=np.uint8)
+    at = (-raw.ctypes.data) % _sp.ALIGN
+    return raw[at:at + _up(n)]
+
+
+def _drop_cache(fd: int) -> None:
+    try:
+        os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
+    except (AttributeError, OSError):
+        pass
+
+
+def _put(path: str, data, owner, direct: bool = False, scratch=None) -> int:
+    """``data`` (bytes, or a list of pieces written in order) to ``path`` through a temporary name, fsynced, renamed;
+    its CRC-32. ``direct``: through one 4 KiB-aligned buffer with O_DIRECT (where the file system takes it), so the
+    page cache, which on a unified-memory GPU is the GPU's memory, keeps no copy; else written and its pages dropped
+    after the fsync. A failed write (a full disk) leaves no temporary file."""
+
+    tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path))
+    parts = [m.cast("B") if m.format != "B" or m.ndim != 1 else m
+             for m in (data if isinstance(data, list) else [memoryview(data)])]
+    total = sum(len(m) for m in parts)
+    crc = 0
+    try:
+        fd = -1
+        if direct and hasattr(os, "O_DIRECT"):
+            try:
+                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_DIRECT, 0o600)
+            except OSError as exc:
+                if exc.errno != errno.EINVAL:
+                    raise
+        try:
+            if fd >= 0:
+                # Only a finite aligned scratch is used. The pending state already
+                # owns its host tensor copies; duplicating the whole file here
+                # would violate the declared host staging cap.
+                buf = scratch if scratch is not None else _aligned_buffer(min(SMALL_IO_BYTES, max(1, total)))
+                capacity = len(buf)
+                if capacity < _sp.ALIGN or capacity % _sp.ALIGN:
+                    raise ValueError("direct write scratch must be aligned whole pages")
+                part, pos, offset = 0, 0, 0
+                while offset < total:
+                    count = min(capacity, total - offset)
+                    written = 0
+                    while written < count:
+                        while part < len(parts) and pos == len(parts[part]):
+                            part += 1
+                            pos = 0
+                        take = min(count - written, len(parts[part]) - pos)
+                        buf[written:written + take] = np.frombuffer(parts[part][pos:pos + take], dtype=np.uint8)
+                        written += take
+                        pos += take
+                    crc = zlib.crc32(memoryview(buf)[:count], crc)
+                    padded = _up(count)
+                    buf[count:padded] = 0
+                    out = memoryview(buf)[:padded]
+                    consumed = 0
+                    while len(out):
+                        k = os.write(fd, out)
+                        if k <= 0:
+                            raise OSError("direct spill write made no progress")
+                        if k != len(out) and k % _sp.ALIGN:
+                            # Resume from this chunk's previous page boundary with
+                            # ordinary I/O. Earlier chunks remain unchanged.
+                            rewind = k - k % _sp.ALIGN
+                            os.close(fd)
+                            fd = os.open(tmp, os.O_WRONLY, 0o600)
+                            os.lseek(fd, offset + consumed + rewind, os.SEEK_SET)
+                            out = out[rewind:]
+                            consumed += rewind
+                            continue
+                        consumed += k
+                        out = out[k:]
+                    offset += count
+                os.ftruncate(fd, total)
+            else:
+                fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+                for mv in parts:
+                    crc = zlib.crc32(mv, crc)
+                    while len(mv):
+                        k = os.write(fd, mv)
+                        if k <= 0:
+                            raise OSError("spill write made no progress")
+                        mv = mv[k:]
+            os.fsync(fd)
+            _drop_cache(fd)                                 # (clean now: nothing of it stays in memory)
+        finally:
+            if fd >= 0:
+                os.close(fd)
+        _chown(tmp, owner)
+        os.replace(tmp, path)
+    except BaseException:
+        try:
+            os.remove(tmp)
+        except OSError:
+            pass
+        raise
+    return crc
+
+
+def _chown(path: str, owner) -> None:
+    if owner is not None:
+        try:
+            os.chown(path, *owner)
+        except OSError:
+            pass
+
