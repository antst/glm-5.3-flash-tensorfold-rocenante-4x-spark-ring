+"""Rank-independent identities and bounds for the CUDA NVMe tier.
+
+Only the engine thread sends these words through its ordered control channel.
+Writer/reader threads never participate in distributed collectives.
+"""
+from __future__ import annotations
+
+import math
+import re
+
+EPOCH_WORDS = 4
+WORD_MAX = (1 << 31) - 1
+GENERATION = re.compile(r"[0-9a-f]{32}-[0-9]+\Z")
+
+
+def epoch_from_words(words):
+    if len(words) != EPOCH_WORDS or any(type(v) is not int or not 0 <= v <= WORD_MAX for v in words):
+        raise ValueError("tier epoch needs four unsigned31-bit control words")
+    return "".join(f"{v:08x}" for v in words)
+
+
+def generation(epoch, counter):
+    if type(counter) is not int or not 0 <= counter <= WORD_MAX:
+        raise ValueError("tier generation counter exhausted or invalid")
+    value = f"{epoch}-{counter}"
+    generation_words(value)
+    return value
+
+
+def generation_words(value):
+    if not isinstance(value, str) or GENERATION.fullmatch(value) is None:
+        raise ValueError("invalid tier generation")
+    epoch, count = value.split("-")
+    words = [int(epoch[i:i + 8], 16) for i in range(0, 32, 8)]
+    epoch_from_words(words)
+    counter = int(count)
+    if counter > WORD_MAX:
+        raise ValueError("tier generation counter exceeds control width")
+    return [*words, counter]
+
+
+def words_generation(words):
+    if len(words) != EPOCH_WORDS + 1:
+        raise ValueError("tier generation payload length")
+    return generation(epoch_from_words(words[:4]), words[4])
+
+
+def kib(n):
+    if type(n) is not int or n < 0:
+        raise ValueError("tier byte count must be nonnegative")
+    return (n + 1023) // 1024
+
+
+def load_timeout(value="300"):
+    seconds = float(value)
+    if not math.isfinite(seconds) or not 1 <= seconds <= 3600:
+        raise ValueError("TF_GLM_SPILL_LOAD_TIMEOUT_S must be1..3600")
+    return seconds
+
+
+def ram_pool_ceiling(value, context):
+    value = value.strip()
+    if not value:
+        return 0
+    if not value.isdecimal():
+        raise ValueError("TF_GLM_POOL_TOKENS must be an integer token count")
+    ceiling = int(value)
+    if ceiling < context or ceiling % 2048 or ceiling > WORD_MAX:
+        raise ValueError("TF_GLM_POOL_TOKENS must be2048-aligned, within31bits, and at least the window")
+    return ceiling
