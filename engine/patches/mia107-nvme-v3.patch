+# -- the index ---------------------------------------------------------------------------------------------------------
+class Point:
+    """A complete state on this rank's disk."""
+
+    __slots__ = ("blocks", "chain", "crcs", "digests", "fields", "head", "ids", "key", "lineage", "n", "shared",
+                 "small_bytes", "small_crc", "tokens", "used", "token_key", "generation", "state_bytes", "host_bytes", "index_bytes", "header_bytes")
+
+    def __init__(self, key, n, ids, tokens, lineage, blocks, crcs, digests, small_crc, small_bytes, shared, head,
+                 used, chain, fields=None, *, token_key="", generation="", state_bytes=0, host_bytes=0, header_bytes=0) -> None:
+        self.key, self.n, self.ids, self.tokens, self.lineage = key, n, ids, tokens, lineage
+        self.blocks, self.crcs, self.digests = blocks, crcs, digests
+        self.small_crc, self.small_bytes, self.shared, self.head = small_crc, small_bytes, shared, head
+        self.used, self.chain, self.fields = used, chain, fields or {}
+        self.token_key, self.generation = token_key, generation
+        self.state_bytes, self.host_bytes = int(state_bytes), int(host_bytes)
+        self.header_bytes = int(header_bytes)
+        self.index_bytes = ids.nbytes + (0 if tokens is None else tokens.nbytes) + 2048 * len(blocks) + 65536
+        self.index_bytes += len(json.dumps(self.fields).encode()) + len(lineage.encode()) + len(generation.encode())
+
+
+def _chain(ids: np.ndarray, block: int) -> list[str]:
+    """Hashes of ``ids`` (no lineage) at each whole block's end: two states' ids share a prefix of k whole blocks
+    exactly when their first k hashes agree."""
+
+    return [h for s, e, h in block_hashes(ids, block) if e - s == block]
+
+
+class Job:
+    """A kept state waiting to be written: its new rows' blocks still in the pool at ``where.base`` (its extent, which
+    may move), the next one to stage, its small state's host bytes."""
+
+    def __init__(self, point: Point, new: list, small: tuple, size: int, where, ids_bytes: bytes) -> None:
+        self.point, self.new, self.size, self.where = point, new, size, where
+        self.small = small                                  # (items, layer): its tensors on the host
+        self.ids_bytes = ids_bytes
+        self.cut: list[str] = []                           # its tail block, copied to the host at keep (``persist``)
+        self.next = 0
+        self.failed: BaseException | None = None
+        self.done = threading.Event()
+        self.cancelled = threading.Event()
+        self.cancel_reason = ""
+        self.copy_events: list = []
+        self.host_bytes = 0
+
+
+class LoadJob:
+    """A read: the reader thread reads its blocks into pinned slots (checked against their CRC-32) and its small state;
+    the engine copies each block read into ``where`` at its base then (``step``: between rounds, on the engine's
+    stream; the extent may move between two steps). ``queued``: block index -> (slot, bytes, its read's future, its
+    tokens, its name); ``next``: the blocks copied. ``done`` once the reader is through, or the read failed
+    (``error``; ``bad`` / ``lost``: the blocks that failed here, damaged or missing); ``stop``: the engine gave up on
+    it, the reader stops."""
+
+    def __init__(self, point: Point, where) -> None:
+        self.point, self.where = point, where
+        self.cond = threading.Condition()
+        self.queued: dict[int, tuple] = {}
+        self.next = 0
+        self.total = len(point.blocks) if point is not None else 0
+        self.stop = False
+        self.done = threading.Event()
+        self.error: BaseException | None = None
+        self.bad: set[str] = set()                          # blocks whose bytes failed (every name of them)
+        self.lost: set[str] = set()                         # blocks whose file is gone (that name)
+        self.small = None
+        self.stage = None
+        self.t0 = time.perf_counter()
+        self.host_reserved = 0
+        self.host_released = False
+        self.finished = False
+
+
+class BlockStore:
+    """This rank's points and blocks, a writer thread, a reader thread."""
+
+    def __init__(self, cfg, *, planes, block: int, rank: int = 0, world: int = 1, device: Any = "cuda",
+                 signature: str = "", weights: str = "", model_id: str = "", gather=None, classes: Sequence[str] = (),
+                 quiet: bool = False, turns: int = TURNS, quota: float = 0.0) -> None:
+        self.cfg, self.planes, self.block = cfg, list(planes), int(block)
+        self.read_blocks = read_blocks()
+        self.stage_mib = _count("TF_GLM_SPILL_STAGE_MIB", STAGE_MIB, "MiB")
+        for p in self.planes:
+            if self.block % p.div:
+                raise ValueError(f"--spill-gib: a cache plane of {p.div} tokens a row does not divide {self.block}")
+        self.rank, self.world, self.device = int(rank), int(world), device
+        self.model_id, self.classes = model_id, list(classes)
+        self.cap = int(cfg.gib * (1 << 30))
+        self.floor = int(cfg.min_free_gib * (1 << 30))
+        self.turns, self.quota = max(0, int(turns)), float(quota)    # turns 0: every turn kept until room is needed
+        self.block_bytes = _span_bytes(self.planes, 0, self.block)
+        shared = hashlib.sha256(f"{FORMAT}|{signature}|block={self.block}".encode()).digest()
+        own = hashlib.sha256(weights.encode()).digest()
+        words = [int.from_bytes(h[i:i + 4], "big", signed=True) for h in (shared, own) for i in range(0, 16, 4)]
+        if self.world > 1 and gather is not None:            # one directory name on every rank
+            rows = gather(words)
+            differ = [r for r, row in enumerate(rows) if list(row[:4]) != list(rows[0][:4])]
+            if differ:
+                print(f"[tensorfold] spill rank {self.rank}: rank(s) {differ} run another build or settings than "
+                      "rank 0, so no rank can resume another's stored prompts until they match", flush=True)
+            words = [w for row in rows for w in row[:8]]
+        self.compat = hashlib.sha256(np.asarray(words, dtype=np.int32).tobytes()).hexdigest()[:16]
+        self.top = os.path.join(cfg.root, f"spill-{self.compat}")
+        self.dir = os.path.join(self.top, f"rank{self.rank}")
+        self.points_dir, self.blocks_dir = os.path.join(self.dir, "points"), os.path.join(self.dir, "blocks")
+        try:
+            st = os.stat(cfg.root)
+            self.owner = (st.st_uid, st.st_gid) if os.geteuid() == 0 and st.st_uid != 0 else None
+        except OSError:
+            self.owner = None
+        self.lock = threading.RLock()
+        self.index: dict[str, Point] = {}
+        self.have: dict[str, tuple[int, int, bytes]] = {}  # block on disk -> (its CRC-32, its inode, its digest)
+        self.content: dict[bytes, str] = {}               # a block's bytes' digest -> a block on disk with them
+        self.inodes: dict[int, list] = {}                 # inode -> [bytes, names on disk]
+        self.small_on_disk = 0                            # bytes of the points' files
+        self.inflight: set[str] = set()                   # points and blocks queued, not yet complete
+        self.reading: set[str] = set()                    # points being read (never evicted meanwhile)
+        self.pinned: set[str] = set()                     # blocks a persist deciding now counts on (never collected)
+        self.parent: dict[str, str | None] = {}           # point -> the longest other point its ids extend
+        self.refs: dict[str, int] = {}                    # block -> points and waiting states naming it
+        self.version = 0                                  # bumped whenever a point comes or goes (the summary's key)
+        self._summary_cache: tuple | None = None
+        self.block_bytes_on_disk = 0                      # bytes of the blocks' inodes (each counted once)
+        self.waiting: dict[str, Job] = {}                 # point key -> its job until written
+        self.pending: list[Job] = []                      # jobs whose rows wait in the pool (the engine loop's)
+        self.jobs: queue.Queue = queue.Queue()            # the writer's work
+        self.reads: queue.Queue = queue.Queue()
+        self.backlog = 0
+        self.host_pending = 0
+        self.index_host_bytes = 0
+        self.read_host_pending = 0
+        self.active_reads = 0
+        self.host_cap = _count("TF_GLM_SPILL_HOST_MIB", HOST_MIB, "MiB") << 20
+        self.read_host_cap = _count("TF_GLM_SPILL_READ_HOST_MIB", HOST_MIB, "MiB") << 20
+        self.small_io_buf = _aligned_buffer(SMALL_IO_BYTES)
+        self.small_io_buf.fill(0)
+        self.results: dict[str, dict] = {}
+        self.aborted: set[str] = set()
+        self.stats = {k: 0 for k in (
+            "written", "written_blocks", "written_bytes", "dedup_blocks", "dedup_bytes", "skipped", "no_space",
+            "backlog_skipped", "write_failed", "pruned_turns", "pruned_forks", "pruned_conversations",
+            "pruned_shared", "quota_trims", "loaded", "loaded_tokens", "loaded_bytes", "load_failed", "crc_failed",
+            "load_unfit", "staged_blocks", "released_blocks", "unwritten_evicted", "dropped", "trimmed_turns",
+            "written_small_bytes", "disk_lookups", "disk_hits", "has_refused")}
+        self.stats.update(write_s=0.0, load_s=0.0, keep_s=0.0, pump_s=0.0, load_small_s=0.0)
+        self.unwritten_by: dict[str, int] = {}
+        self.restore_ms: list[float] = []
+        self.direct = bool(getattr(cfg, "direct", True)) and hasattr(os, "O_DIRECT")
+        self.small_direct = self.direct                     # small states: O_DIRECT through their own aligned buffer
+        problem, pruned_builds = "", 0
+        try:
+            for d in (self.top, self.dir, self.points_dir, self.blocks_dir):
+                os.makedirs(d, mode=0o700, exist_ok=True)
+                os.chmod(d, 0o700)
+                _chown(d, self.owner)
+            pruned_builds = self._prune_builds()
+            self._scan()
+        except OSError as exc:
+            problem = repr(exc)
+        flags = gather([int(bool(problem))]) if self.world > 1 and gather is not None else [[int(bool(problem))]]
+        bad = [r for r, row in enumerate(flags) if row[0]]
+        if bad:                                           # every rank stops alike: none waits on another
+            raise RuntimeError(f"--snapshot-dir {cfg.root}: rank(s) {bad} cannot use it"
+                               + (f": {problem}" if problem else ""))
+        self.slots: list[torch.Tensor] = []
+        self.free_slots: queue.Queue = queue.Queue()
+        self.dev_slot: torch.Tensor | None = None
+        self.slot_events: list = []                        # a write slot's event, reused by every block it stages
+        self.read_slots: list[torch.Tensor] = []
+        self._hasher = ThreadPoolExecutor(2, thread_name_prefix=f"spill-hash-{self.rank}")
+        self._readers = ThreadPoolExecutor(READERS, thread_name_prefix=f"spill-read-{self.rank}")
+        threading.Thread(target=self._writer, name=f"spill-writer-{self.rank}", daemon=True).start()
+        threading.Thread(target=self._read_loop, name=f"spill-reader-{self.rank}", daemon=True).start()
+        if self.rank == 0 and not quiet:
+            print(f"[tensorfold] spill: {self.top} ({cfg.gib:g} GiB a rank, blocks of {self.block} tokens, written "
+                  f"when kept, from {cfg.min_tokens} tokens{', O_DIRECT' if self.direct else ''}, floor "
+                  f"{cfg.min_free_gib:g} GiB free, {self.read_blocks} blocks read ahead "
+                  f"({self.read_blocks * _span_bytes(self.planes, 0, self.block) / (1 << 20):.0f} MiB), a "
+                  f"{self.stage_mib} MiB write ring): {len(self.index)} stored prompts from before this start, "
+                  f"{self.stored() / (1 << 30):.1f} GiB"
+                  + (f"; pruned {pruned_builds} older builds" if pruned_builds else ""), flush=True)
+
+    # -- housekeeping --------------------------------------------------------------------------------------------------
+    def _prune_builds(self) -> int:
+        """Folders of other compatibility hashes (other builds, formats, layouts): the newest ``keep_builds`` stay."""
+
+        try:
+            others = [os.path.join(self.cfg.root, d) for d in os.listdir(self.cfg.root)
+                      if d.startswith("spill-") and os.path.join(self.cfg.root, d) != self.top]
+        except OSError:
+            return 0
+        others = [d for d in others if os.path.isdir(d)]
+        others.sort(key=lambda d: os.stat(d).st_mtime, reverse=True)
+        gone = 0
+        for d in others[max(0, int(getattr(self.cfg, "keep_builds", 1))):]:
+            mine = os.path.join(d, f"rank{self.rank}")
+            if os.path.isdir(mine):
+                shutil.rmtree(mine, ignore_errors=True)
+                gone += 1
+            try:
+                os.rmdir(d)
+            except OSError:
+                pass
+        return gone
+
+    def disk_free(self) -> int:
+        try:
+            st = os.statvfs(self.dir)
+            return st.f_bavail * st.f_frsize
+        except OSError:
+            return 0
+
+    def stored(self) -> int:
+        with self.lock:
+            return self.block_bytes_on_disk + self.small_on_disk
+
+    def _block_path(self, h: str) -> str:
+        return os.path.join(self.blocks_dir, f"{h}.bin")
+
+    def _point_path(self, key: str, suffix: str) -> str:
+        return os.path.join(self.points_dir, f"{key}{suffix}")
+
+    def _add_block(self, h: str, crc: int, digest: bytes | None) -> None:
+        """Lock held: block ``h`` is on disk (its inode counted once whatever names it)."""
+
+        st = os.stat(self._block_path(h))
+        self.have[h] = (crc, st.st_ino, digest or bytes(16))
+        if st.st_ino not in self.inodes:
+            self.inodes[st.st_ino] = [_up(st.st_size), set()]
+            self.block_bytes_on_disk += _up(st.st_size)
+        self.inodes[st.st_ino][1].add(h)
+        if digest is not None:
+            self.content.setdefault(digest, h)
+
+    def _drop_block(self, h: str) -> None:
+        """Lock held: block ``h``'s name goes (its bytes once no name holds its inode)."""
+
+        got = self.have.pop(h, None)
+        if got is None:
+            return
+        ent = self.inodes.get(got[1])
+        if ent is not None:
+            ent[1].discard(h)
+            if not ent[1]:
+                self.inodes.pop(got[1], None)
+                self.block_bytes_on_disk -= ent[0]
+        if self.content.get(got[2]) == h:                   # its bytes under another name, or gone
+            other = next(iter(ent[1]), None) if ent is not None else None
+            if other is not None:
+                self.content[got[2]] = other
+            else:
+                self.content.pop(got[2], None)
+        try:
+            os.remove(self._block_path(h))
+        except OSError:
+            pass
+
+    def _scan(self) -> None:
+        """Points whose json, ids, small state and every block are on disk; the rest (a write a crash cut short, a
+        damaged point) go, and so do blocks no point names."""
+
+        for d in (self.points_dir, self.blocks_dir):
+            for f in os.listdir(d):
+                if f.startswith("."):                       # a write cut off before its rename
+                    try:
+                        os.remove(os.path.join(d, f))
+                    except OSError:
+                        pass
+        present = {f[:-4] for f in os.listdir(self.blocks_dir) if f.endswith(".bin")}
+        metas = []
+        for f in os.listdir(self.points_dir):
+            if f.endswith(".json"):
+                p = os.path.join(self.points_dir, f)
+                try:
+                    metas.append((os.stat(p).st_mtime, f[:-5]))
+                except OSError:
+                    pass
+        for used, key in sorted(metas, reverse=True):
+            try:
+                manifest_path = self._point_path(key, ".json")
+                if os.stat(manifest_path).st_size > MAX_MANIFEST_BYTES:
+                    raise ValueError("manifest exceeds bounded recovery parser")
+                with open(manifest_path) as fh:
+                    m = json.load(fh)
+                if m.get("format") != FORMAT or m["key"] != key:
+                    raise ValueError("another format")
+                n = int(m["n"])
+                id_size = os.stat(self._point_path(key, ".ids")).st_size
+                if n < 1 or id_size not in (8 * n, 16 * n) or id_size > self.host_cap:
+                    raise ValueError("IDs exceed bounded point geometry")
+                with open(self._point_path(key, ".ids"), "rb") as fh:
+                    raw = fh.read()
+                if zlib.crc32(raw) != m["ids_crc"] or not os.path.exists(self._point_path(key, ".st")):
+                    raise ValueError("ids or small state")
+                arr = np.frombuffer(raw, dtype=np.int64)
+                n = int(m["n"])
+                ids, tokens = arr[:n].copy(), (arr[n:].copy() if len(arr) > n else None)
+                blocks = list(m["blocks"])
+                if (len(ids) != n or snapshot_key(ids, m["generation"]) != key or m["token_key"] != point_key(ids) or not all(b in present for b in blocks)
+                        or [h for _, _, h in block_hashes(ids, self.block, m["lineage"])] != blocks):
+                    raise ValueError("blocks")
+                pt = Point(key, n, ids, tokens, m["lineage"], blocks, [int(c) for c in m["crcs"]],
+                           [bytes.fromhex(x) for x in m["digests"]], int(m["small_crc"]), int(m["small_bytes"]),
+                           bool(m["shared"]), bool(m["head"]), float(used), _chain(ids, self.block),
+                           m.get("fields") or {}, token_key=m["token_key"], generation=m["generation"],
+                           state_bytes=m["state_bytes"], host_bytes=m["host_bytes"], header_bytes=m["header_bytes"])
+                if self.index_host_bytes + pt.index_bytes > self.host_cap:
+                    raise ValueError("bounded index metadata capacity exhausted")
+                if len(pt.crcs) != len(blocks) or len(pt.digests) != len(blocks) or pt.state_bytes < 0 or pt.host_bytes < 0 or pt.header_bytes < 0 or pt.header_bytes > MAX_MANIFEST_BYTES:
+                    raise ValueError("invalid bounded point geometry")
+                self.index_host_bytes += pt.index_bytes
+                self.index[key] = pt
+                for b, c, dg in zip(blocks, pt.crcs, pt.digests):
+                    if b not in self.have:
+                        self._add_block(b, c, dg)
+                self.small_on_disk += pt.small_bytes
+            except Exception:                              # noqa: BLE001, S112  (torn, damaged or foreign: gone below)
+                continue
+        for f in os.listdir(self.points_dir):
+            if f.split(".")[0] not in self.index:
+                try:
+                    os.remove(os.path.join(self.points_dir, f))
+                except OSError:
+                    pass
+        for b in present - self.have.keys():
+            try:
+                os.remove(self._block_path(b))
+            except OSError:
+                pass
+        for pt in sorted(self.index.values(), key=lambda p: p.n):
+            self.parent[pt.key] = self._parent_of(pt)
+            self._ref(pt.blocks, 1)
+
+    # -- the staging ring and read buffers ---------------------------------------------------------------------------
+    def ring(self) -> None:
+        """Pinned host slots of one block each for writes (carved from ``spill.preallocate``'s write buffers, else
+        allocated now), and as many for reads, all touched now; a device buffer a block is gathered in; an event a
+        write slot, made here: making or dropping one later (the writer dropped one a block) waits for the engine's
+        round to end whenever it decodes (CUDA holds every other thread's call while the round's readback waits on the
+        default stream), ~27 ms a block beside a decoding stream."""
+
+        if self.slots:
+            return
+        per = _up(self.block_bytes)
+        dev = self.planes[0].tensor.device
+        pin = dev.type == "cuda"
+
+        def carve(bufs, count_min):
+            out = []
+            for b in bufs:
+                for i in range(0, b.numel() - per + 1, per):
+                    out.append(b[i:i + per])
+            while len(out) < count_min:
+                out.append(torch.empty(per, dtype=torch.uint8, pin_memory=pin))
+            return out
+
+        self.slots = carve(_sp._PINNED.get("write") or [], max(2, (self.stage_mib << 20) // per))
+        early = sum(b.numel() // per for b in _sp._PINNED.get("read") or [])
+        self.read_slots = carve(_sp._PINNED.get("read") or [], self.read_blocks)
+        if early < self.read_blocks and self.rank == 0:
+            print(f"[tensorfold] spill: {self.read_blocks - early} of {self.read_blocks} read-ahead slots pinned after "
+                  "the pool was sized (from the margin it keeps)", flush=True)
+        self.free_reads: queue.Queue = queue.Queue()
+        for i in range(len(self.read_slots)):
+            self.free_reads.put(i)
+        self.read_events: list = []                         # (slot, the engine's event after its copy out of it)
+        for s in self.slots + self.read_slots:
+            s.fill_(0)
+        if any(s.data_ptr() % _sp.ALIGN for s in self.slots + self.read_slots):
+            self.direct = False
+        self.dev_slot = torch.empty(per, dtype=torch.uint8, device=dev)
+        if dev.type == "cuda":
+            for _ in self.slots:
+                ev = torch.cuda.Event()
+                ev.record()                                 # (an event is made at its first record)
+                self.slot_events.append(ev)
+        for i in range(len(self.slots)):
+            self.free_slots.put(i)
+
+    # -- write ---------------------------------------------------------------------------------------------------------
+    def wants(self, n: int) -> bool:
+        return n >= self.cfg.min_tokens
+
+    def has(self, key: str) -> bool:
+        """Exact-generation local durable point. Global durability is the caller's all-rank ACK."""
+        with self.lock:
+            pt = self.index.get(key)
+            return (pt is not None and key not in self.aborted
+                    and all(b in self.have for b in pt.blocks)
+                    and os.path.isfile(self._point_path(key, ".json")))
+
+    def _remember(self, key: str, state: str, reason: str = "", **extra) -> None:
+        with self.lock:
+            self.results[key] = {"state": state, "reason": reason[:512], "key": key, **extra}
+            while len(self.results) > RESULT_LIMIT:
+                victim = next((k for k in self.results if k not in self.waiting), None)
+                if victim is None:
+                    break
+                self.results.pop(victim)
+                self.aborted.discard(victim)
+
+    @staticmethod
+    def _rows_safe(job: Job) -> bool:
+        # Events are queried on the engine thread, never waited on. Reuse of an
+        # event is safe because the writer removes it before returning its slot.
+        outstanding = []
+        for event in job.copy_events:
+            if event is not None and not event.query():
+                outstanding.append(event)
+        job.copy_events = outstanding
+        return job.next >= len(job.new) and not outstanding
+
+    def status(self, key: str) -> dict:
+        with self.lock:
+            job = self.waiting.get(key)
+            pt = self.index.get(key) or (job.point if job is not None else None)
+            receipt = dict(self.results.get(key, {"state": "refused", "reason": "unknown_key", "key": key}))
+            if key in self.aborted:
+                receipt["state"] = "failed"
+                receipt.setdefault("reason", "cancelled")
+            elif self.has(key):
+                receipt["state"] = "committed"
+            elif job is not None:
+                receipt["state"] = "failed" if job.failed is not None else "queued"
+            elif receipt["state"] == "committed":
+                receipt["state"] = "missing" if pt is not None else "evicted"
+                receipt["reason"] = "durable_point_no_longer_available"
+            receipt.update(durable=self.has(key), rows_safe=job is None or self._rows_safe(job),
+                           terminal=job is None, pending_bytes=0 if job is None else job.size)
+            if pt is not None:
+                receipt.update(token_key=pt.token_key, generation=pt.generation, n=pt.n,
+                               state_bytes=pt.state_bytes, host_bytes=pt.host_bytes)
+            return receipt
+
+    def metadata(self, key: str) -> dict | None:
+        with self.lock:
+            pt = self.index.get(key)
+            if pt is None or not self.has(key):
+                return None
+            return {"key": pt.key, "token_key": pt.token_key, "generation": pt.generation,
+                    "n": pt.n, "state_bytes": pt.state_bytes, "host_bytes": pt.host_bytes,
+                    "header_bytes": pt.header_bytes, "small_read_reservation": self._small_read_bytes(pt),
+                    "compat": self.compat, "format": FORMAT}
+
+    @staticmethod
+    def _small_read_bytes(pt: Point) -> int:
+        return _up(pt.host_bytes) + 8 * pt.header_bytes + 16384
+
+    def small_read_reservation(self, key: str) -> int | None:
+        """Authoritative host reservation, before ordered all-rank LOAD admission."""
+        with self.lock:
+            pt = self.index.get(key)
+            return self._small_read_bytes(pt) if pt is not None and self.has(key) else None
+
+    def abort(self, key: str, reason: str = "coordinated_abort") -> dict:
+        """Stop new staging and publication. Already queued finite-ring I/O may settle.
+
+        rows_safe and terminal are distinct: the former permits pool mutation;
+        the latter confirms publication cleanup completed. No thread collective.
+        """
+        with self.lock:
+            self.aborted.add(key)
+            job = self.waiting.get(key)
+            if job is not None:
+                job.cancel_reason = str(reason)[:512]
+                job.cancelled.set()
+                job.failed = RuntimeError(job.cancel_reason)
+                job.next = len(job.new)
+            if key in self.index:
+                self._remove(key, "dropped")
+            self._remember(key, "failed", str(reason))
+        self.pump(0)  # terminal jobs enqueue after all previously captured blocks
+        return self.status(key)
+
+    def touch(self, key: str) -> None:
+        with self.lock:
+            pt = self.index.get(key)
+            if pt is not None:
+                pt.used = time.time()
+        try:
+            os.utime(self._point_path(key, ".json"), None)
+        except OSError:
+            pass
+
+    def persist(self, ids: Sequence[int], obj, *, extent, lineage: str, tokens: Sequence[int] | None = None,
+                shared: bool = False, head: bool = False, skip: Sequence[str] = (), fields: dict | None = None,
+                generation: str | None = None) -> str:
+        """Queue an immutable shared-generation snapshot, or explicitly refuse it.
+
+        "queued" is not a durable ACK. Missing generations fail closed without
+        staging. The caller must protect every extent until all-rank rows_safe,
+        and retry/refuse/abort through its ordered control protocol.
+        """
+        t0 = time.perf_counter()
+        token_key = point_key(ids)
+        try:
+            key = snapshot_key_from_token(token_key, generation)
+        except (TypeError, ValueError) as exc:
+            self._remember(token_key, "refused", "missing_or_invalid_generation: " + str(exc))
+            return "refused"
+        with self.lock:
+            if key in self.aborted:
+                self._remember(key, "failed", "generation_previously_aborted")
+                return "failed"
+            if key in self.index or key in self.waiting:
+                pt = self.index.get(key) or self.waiting[key].point
+                pt.used = time.time()
+                if shared and not pt.shared:
+                    pt.shared = True
+                    self.version += 1
+                    if key in self.index:
+                        self.jobs.put(("shared", None, key, None))
+                self.stats["skipped"] += 1
+                return "committed" if self.has(key) else "queued"
+        # Copy admission precedes any host clone. IDs and fixed-state copies are
+        # separately bounded, while unstaged row history remains in the pool.
+        items, layer = _sp.encode(obj, skip=skip)
+        state_bytes = max(_state_bytes(items), sum(t.numel() * t.element_size() for _, t in items))
+        header, tensor_bytes = _sp._header(items, {"format": FORMAT, "layer": json.dumps(layer)})
+        n = len(ids)
+        if len(header) > MAX_MANIFEST_BYTES:
+            self._remember(key, "refused", "fixed_header_limit", token_key=token_key, generation=generation)
+            return "refused"
+        id_bytes = 8 * n * (2 if tokens is not None else 1)
+        # IDs arrays + serialized IDs, fixed tensors, headers/metadata and Python
+        # block/control bookkeeping (512 bytes per block) are covered here.
+        host_need = tensor_bytes + 2 * id_bytes + 4 * len(header) + 2048 * (-(-n // self.block)) + 65536
+        host_need += 2 * len(json.dumps(fields or {}).encode()) + 2 * len(lineage.encode())
+        with self.lock:
+            if host_need > self.host_cap or self.index_host_bytes + self.host_pending + host_need > self.host_cap:
+                self.stats["backlog_skipped"] += 1
+                self._remember(key, "refused", "host_metadata_cap", token_key=token_key, generation=generation)
+                return "refused"
+        ids = np.asarray(ids, dtype=np.int64).copy()
+        hashes = block_hashes(ids, self.block, lineage)
+        pins = {h for _, _, h in hashes}
+        with self.lock:
+            self.pinned |= pins
+        try:
+            return self._persist(key, n, ids, obj, extent, lineage, tokens, shared, head, skip, fields, hashes, t0,
+                                 generation, token_key, items, layer, header, state_bytes, host_need)
+        except Exception as exc:
+            self._remember(key, "failed", "admission_error: " + repr(exc), token_key=token_key, generation=generation)
+            return "failed"
+        finally:
+            with self.lock:
+                self.pinned -= pins
+                self._gc(pins)
+
+    def _persist(self, key, n, ids, obj, extent, lineage, tokens, shared, head, skip, fields, hashes, t0,
+                 generation, token_key, items, layer, header, state_bytes, host_need) -> str:
+        self.ring()
+        with self.lock:
+            new = [(s, e, h) for s, e, h in hashes if h not in self.have and h not in self.inflight]
+        tails = [(s, e, h) for s, e, h in new if e - s < self.block]
+        # Freeze the mutable last block in an existing finite slot at admission.
+        slot = None
+        if tails:
+            try:
+                slot = self.free_slots.get_nowait()
+            except queue.Empty:
+                self._remember(key, "refused", "tail_ring_busy", token_key=token_key, generation=generation)
+                return "refused"
+        rows_need = sum(_up(_span_bytes(self.planes, s, e)) for s, e, _ in new)
+        small_size = len(header) + sum(t.numel() * t.element_size() for _, t in items)
+        id_size = 8 * n * (2 if tokens is not None else 1)
+        pt = Point(key, n, ids, None if tokens is None else np.asarray(tokens, dtype=np.int64).copy(), lineage,
+                   [h for _, _, h in hashes], [], [], 0, 0, bool(shared), bool(head), time.time(), None, fields,
+                   token_key=token_key, generation=generation, state_bytes=state_bytes, host_bytes=small_size, header_bytes=len(header))
+        # Conservative complete manifest (including fixed fields, CRC/digest lists)
+        # reservation, plus filesystem allocation padding for every file.
+        manifest_n = len(json.dumps({"format": FORMAT, "key": key, "token_key": token_key, "generation": generation,
+                                    "lineage": lineage, "fields": fields or {}, "blocks": pt.blocks,
+                                    "crcs": [4294967295] * len(hashes), "digests": ["f" * 32] * len(hashes)}).encode()) + 8192
+        need = rows_need + _up(small_size) + _up(id_size) + _up(manifest_n)
+        try:
+            with self.lock:
+                # A disk floor refusal must not prune old durable points. All
+                # pending row+state+ID+manifest reservations are counted together.
+                if self.backlog + need > BACKLOG:
+                    self.stats["backlog_skipped"] += 1
+                    self._remember(key, "refused", "pending_disk_cap", token_key=token_key, generation=generation)
+                    return "refused"
+                if self.floor + self.backlog + need > self.disk_free():
+                    self.stats["no_space"] += 1
+                    self._remember(key, "refused", "disk_free_floor", token_key=token_key, generation=generation)
+                    return "refused"
+                if self.stored() + self.backlog + need > self.cap:
+                    over = self.stored() + self.backlog + need - self.cap
+                    if over > self.stored():
+                        self.stats["no_space"] += 1
+                        self._remember(key, "refused", "disk_capacity", token_key=token_key, generation=generation)
+                        return "refused"
+                    self._make_room(over, protect={key})
+                if self.stored() + self.backlog + need > self.cap:
+                    self._remember(key, "refused", "protected_disk_capacity", token_key=token_key, generation=generation)
+                    return "refused"
+                # Quota eviction only after floor/cap/host/ring acceptance checks.
+                if self.quota > 0:
+                    self._trim_own(pt, need)
+                if self.index_host_bytes + self.host_pending + host_need > self.host_cap:
+                    self._remember(key, "refused", "host_metadata_cap", token_key=token_key, generation=generation)
+                    return "refused"
+                self.backlog += need
+                self.host_pending += host_need
+                self.inflight.add(key)
+                self.inflight.update(h for _, _, h in new)
+                self._ref(pt.blocks, 1)
+            try:
+                host_items = [(k, _host(t)) for k, t in items]
+                ids_bytes = ids.tobytes() + (b"" if tokens is None else np.asarray(tokens, dtype=np.int64).tobytes())
+                job = Job(pt, [b for b in new if b not in tails], (host_items, layer), need, extent, ids_bytes)
+                job.host_bytes = host_need
+                job.cut = [h for _, _, h in tails]
+                with self.lock:
+                    self.waiting[key] = job
+                    self._remember(key, "queued", token_key=token_key, generation=generation)
+                if tails:
+                    s, e, h = tails[0]
+                    self._stage(job, s, e, h, slot)
+                    slot = None  # the writer owns this finite slot now
+                self.pending.append(job)
+                self.stats["keep_s"] += time.perf_counter() - t0
+                return "queued"
+            except Exception:
+                with self.lock:
+                    self.waiting.pop(key, None)
+                    self.backlog -= need
+                    self.host_pending -= host_need
+                    self.inflight.difference_update([key] + [h for _, _, h in new])
+                    self._ref(pt.blocks, -1)
+                raise
+        finally:
+            if slot is not None:
+                self.free_slots.put(slot)
+
+    def _stage(self, job: Job, s: int, e: int, h: str, slot: int) -> None:
+        parts = self._parts(job.where, s, e)
+        nb = sum(t.numel() for t in parts)
+        torch.cat(parts, out=self.dev_slot[:nb])
+        self.slots[slot][:nb].copy_(self.dev_slot[:nb], non_blocking=True)
+        ev = self.slot_events[slot] if self.slot_events else None
+        if ev is not None:
+            ev.record()
+            job.copy_events.append(ev)
+        self.jobs.put(("block", job, h, (slot, nb, ev)))
+
+    def _parts(self, where, s: int, e: int) -> list[torch.Tensor]:
+        """Tokens [s, e) as each plane's rows, where the extent is NOW (it may have moved)."""
+
+        base = where.base
+        out = []
+        for p in self.planes:
+            a, b = _rows(p, s, e)
+            t = p.tensor[base // p.div + a:base // p.div + b]
+            out.append(t.reshape(-1).view(torch.uint8))
+        return out
+
+    def pump(self, limit: int | None = PUMP_BLOCKS) -> None:
+        """Between rounds (the engine loop, every rank): the waiting states' next blocks, oldest first, into free slots
+        - one device gather (a kernel: display-span rows too) and one copy to pinned memory each, on the current stream
+        after whatever wrote the rows - handed to the writer with the slot's event (made at start, ``ring``). A state
+        whose blocks are all handed goes to the writer whole. Never waits; at most ``limit`` blocks (None: as many as
+        the slots allow)."""
+
+        if not self.pending:
+            return
+        t0 = time.perf_counter()
+        self.ring()
+        limit = 1 << 62 if limit is None else limit
+        while self.pending:
+            job = self.pending[0]
+            while job.next < len(job.new):
+                if limit <= 0:
+                    self.stats["pump_s"] += time.perf_counter() - t0
+                    return
+                try:
+                    slot = self.free_slots.get_nowait()
+                except queue.Empty:
+                    self.stats["pump_s"] += time.perf_counter() - t0
+                    return
+                limit -= 1
+                s, e, h = job.new[job.next]
+                try:
+                    if not job.cancelled.is_set():
+                        self._stage(job, s, e, h, slot)
+                    else:
+                        self.free_slots.put(slot)
+                except Exception as exc:
+                    self.free_slots.put(slot)
+                    job.failed = exc
+                    job.next = len(job.new)
+                    print(f"[tensorfold] spill rank {self.rank}: staging {job.point.key} failed: {exc!r}", flush=True)
+                    break
+                job.next += 1
+                self.stats["staged_blocks"] += 1
+            self.pending.pop(0)
+            self.jobs.put(("point", job, None, None))
+        self.stats["pump_s"] += time.perf_counter() - t0
+
+    def stage_all(self, timeout: float = 10.0) -> None:
+        """Every waiting block through the ring now (an engine about to idle: nothing pumps meanwhile), for at most
+        ``timeout`` seconds (slots come back as the writer writes); what is left goes at the next pumps."""
+
+        end = time.monotonic() + timeout
+        while self.pending and time.monotonic() < end:
+            self.pump(None)
+            if self.pending:
+                time.sleep(0.001)
+
+    def drain(self, timeout: float | None = None) -> bool:
+        """Every waiting state to the writer and on disk, and the json rewrites queued before (``_mark_shared``) too
+        (an idle engine, a shutdown). True means terminal work completed in time,
+        not that every write succeeded; query status for explicit durable ACKs."""
+
+        end = None if timeout is None else time.monotonic() + timeout
+        while self.pending:
+            self.pump(None)
+            if self.pending:
+                time.sleep(0.001)
+            if end is not None and time.monotonic() > end:
+                return False
+        with self.lock:
+            jobs = list(self.waiting.values())
+        for job in jobs:
+            left = None if end is None else max(0.0, end - time.monotonic())
+            if not job.done.wait(left):
+                return False
+        synced = threading.Event()                          # (behind every rewrite those jobs or a keep queued)
+        self.jobs.put(("sync", None, None, synced))
+        return synced.wait(None if end is None else max(0.0, end - time.monotonic()))
+
+    def prepare_release(self, extent, keep: int) -> bool:
+        """Nonblocking bounded-ring progress before destructive extent mutation.
+
+        No pageable history copy and no additional allocation. False leaves the
+        original extent protected. True says captured copy events have completed,
+        not that a point is durable. All ranks must agree before mutation.
+        """
+        self.pump(None)
+        with self.lock:
+            conflicting = [j for j in self.waiting.values()
+                           if j.where is extent and j.point.n > keep]
+            return all(self._rows_safe(j) for j in conflicting)
+
+    def release(self, extent, keep: int) -> bool:
+        if not self.prepare_release(extent, keep):
+            raise Backpressure("pool extent still owns unstaged NVMe snapshot rows")
+        return True
+
+    def _write_block(self, h: str, mv: memoryview, nb: int, room: bool) -> None:
+        """The writer: a block (its CRC-32 and digest computed beside the write), or a link to a block on disk with the
+        same bytes. Through a temporary name, fsynced, renamed; a failure leaves no temporary file."""
+
+        data = mv[:nb]                                      # ``room``: mv runs on to a 4 KiB multiple (O_DIRECT)
+        crc_f = self._hasher.submit(_crc, data)
+        dig_f = self._hasher.submit(_digest, data)
+        dig = dig_f.result()
+        crc = crc_f.result()
+        path, tmp = self._block_path(h), os.path.join(self.blocks_dir, f".{h}.bin")
+        with self.lock:
+            same = self.content.get(dig)
+            same = same if same is not None and same in self.have and self.have[same][0] == crc else None
+        try:
+            if same is not None:                            # the same bytes on disk: a second name for them
+                try:
+                    os.link(self._block_path(same), tmp)
+                    os.replace(tmp, path)
+                except OSError:                             # (gone meanwhile: written below instead)
+                    same = None
+                    try:
+                        os.remove(tmp)
+                    except OSError:
+                        pass
+            if same is not None:
+                with self.lock:
+                    self._add_block(h, crc, dig)
+                    self.stats["dedup_blocks"] += 1
+                    self.stats["dedup_bytes"] += nb
+                return
+            flags = os.O_WRONLY | os.O_CREAT | os.O_TRUNC
+            fd, direct = -1, False
+            if self.direct and room:
+                try:
+                    fd, direct = os.open(tmp, flags | os.O_DIRECT, 0o600), True
+                except OSError as exc:
+                    if exc.errno != errno.EINVAL:
+                        raise
+                    self.direct = False
+            if fd < 0:
+                fd = os.open(tmp, flags, 0o600)
+            try:
+                out = mv[:_up(nb)] if direct else data
+                while len(out):
+                    k = os.write(fd, out)
+                    if direct and k != len(out):            # (a partial O_DIRECT write: the rest, buffered)
+                        os.close(fd)
+                        fd = os.open(tmp, os.O_WRONLY | os.O_TRUNC, 0o600)
+                        out, direct = data, False
+                        continue
+                    out = out[k:]
+                if direct:
+                    os.ftruncate(fd, nb)
+                os.fsync(fd)
+                try:
+                    os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
+                except (AttributeError, OSError):
+                    pass
+            finally:
+                os.close(fd)
+            _chown(tmp, self.owner)
+            os.replace(tmp, path)
+            with self.lock:
+                self._add_block(h, crc, dig)
+                self.stats["written_blocks"] += 1
+                self.stats["written_bytes"] += nb
+        except BaseException:
+            try:
+                os.remove(tmp)
+            except OSError:
+                pass
+            raise
+
+    def _writer(self) -> None:
+        while True:
+            kind, job, h, item = self.jobs.get()
+            t0 = time.perf_counter()
+            if kind == "block":
+                slot, nb, ev = item
+                try:
+                    if ev is not None:
+                        ev.synchronize()
+                    with self.lock:
+                        if ev in job.copy_events:
+                            job.copy_events.remove(ev)
+                    if job.failed is None and not job.cancelled.is_set():
+                        self._write_block(h, memoryview(self.slots[slot].numpy()), nb, True)
+                except Exception as exc:                    # noqa: BLE001  (a full or failing disk: not kept on disk)
+                    job.failed = exc
+                finally:
+                    self.free_slots.put(slot)
+                self.stats["write_s"] += time.perf_counter() - t0
+                continue
+            if kind == "sync":                              # (``drain``: everything queued before it is done)
+                item.set()
+                continue
+            if kind == "shared":
+                try:
+                    self._mark_shared(h)
+                except Exception as exc:                    # noqa: BLE001  (the flag holds in memory until a restart)
+                    print(f"[tensorfold] spill rank {self.rank}: marking {h} shared failed: {exc!r}", flush=True)
+                continue
+            if kind == "rows":
+                try:
+                    if job.failed is None:
+                        raw = item.view(-1).view(torch.uint8)
+                        self._write_block(h, memoryview(raw.numpy()), raw.numel(), False)
+                except Exception as exc:                    # noqa: BLE001
+                    job.failed = exc
+                self.stats["write_s"] += time.perf_counter() - t0
+                continue
+            self._write_point(job)
+            self.stats["write_s"] += time.perf_counter() - t0
+
+    def _mark_shared(self, key: str) -> None:
+        """The writer: point ``key``'s json again with ``"shared": true`` (its ids kept again as a shared prefix), the
+        way it was first written (a temporary name, fsynced, renamed, then the points' folder fsynced). A point dropped
+        before is left alone; one dropped while this ran loses the json this wrote back."""
+
+        with self.lock:
+            pt = self.index.get(key)
+        if pt is None:
+            return
+        path = self._point_path(key, ".json")
+        try:
+            with open(path, "rb") as fh:
+                meta = json.loads(fh.read())
+        except FileNotFoundError:                           # (dropped meanwhile)
+            return
+        meta["shared"] = True
+        _put(path, json.dumps(meta).encode(), self.owner)
+        _fsync_dir(self.points_dir)
+        with self.lock:
+            gone = self.index.get(key) is not pt
+        if gone:
+            try:
+                os.remove(path)
+            except OSError:
+                pass
+
+    def _write_point(self, job: Job) -> None:
+        pt = job.point
+        try:
+            if job.failed is not None or job.cancelled.is_set():
+                raise job.failed or RuntimeError("cancelled")
+            with self.lock:
+                got = [self.have.get(b) for b in pt.blocks]
+                if None in got:
+                    raise RuntimeError(f"{got.count(None)} of its blocks are no longer on disk")
+                pt.crcs = [c for c, _, _ in got]
+                pt.digests = [d for _, _, d in got]
+                shared = pt.shared                          # (kept again as shared after this: rewritten below)
+            _fsync_dir(self.blocks_dir)                     # the blocks' renames before the point naming them
+            ids_crc = _put(self._point_path(pt.key, ".ids"), job.ids_bytes, self.owner)
+            parts = _small_parts(*job.small)
+            pt.small_crc = _put(self._point_path(pt.key, ".st"), parts, self.owner, direct=self.small_direct,
+                                scratch=self.small_io_buf)
+            _fsync_dir(self.points_dir)
+            meta = {"format": FORMAT, "key": pt.key, "token_key": pt.token_key, "generation": pt.generation,
+                    "state_bytes": pt.state_bytes, "host_bytes": pt.host_bytes, "header_bytes": pt.header_bytes, "n": pt.n, "lineage": pt.lineage, "blocks": pt.blocks,
+                    "crcs": pt.crcs, "digests": [d.hex() for d in pt.digests], "ids_crc": ids_crc,
+                    "small_crc": pt.small_crc, "small_bytes": _up(sum(len(m) for m in parts)) + _up(len(job.ids_bytes)) + _up(8192 + len(json.dumps(pt.fields).encode()) + len(pt.blocks) * 128),
+                    "shared": shared, "head": pt.head, "fields": pt.fields}
+            pt.chain = _chain(pt.ids, self.block)
+            if job.cancelled.is_set():
+                raise RuntimeError(job.cancel_reason or "cancelled")
+            _put(self._point_path(pt.key, ".json"), json.dumps(meta).encode(), self.owner)
+            _fsync_dir(self.points_dir)
+            pt.small_bytes = meta["small_bytes"]
+            with self.lock:
+                if job.cancelled.is_set() or any(b not in self.have for b in pt.blocks):
+                    for suffix in (".json", ".st", ".ids"):
+                        try:
+                            os.remove(self._point_path(pt.key, suffix))
+                        except OSError:
+                            pass
+                    raise RuntimeError("a block it names was dropped while it was written")
+                self._remember(pt.key, "committed", token_key=pt.token_key, generation=pt.generation)
+                self.index[pt.key] = pt
+                self.index_host_bytes += pt.index_bytes
+                self._ref(pt.blocks, 1)                     # (its own reference; the waiting one goes below)
+                self._adopt(pt)
+                self.small_on_disk += pt.small_bytes
+                self.stats["written"] += 1
+                self.stats["written_small_bytes"] += pt.small_bytes
+                self.version += 1
+                self._trim_path(pt)
+                if pt.shared and not shared:
+                    self.jobs.put(("shared", None, pt.key, None))
+        except Exception as exc:                            # noqa: BLE001  (only this state is not kept on disk)
+            job.failed = exc
+            self.stats["write_failed"] += 1
+            self._remember(pt.key, "failed", repr(exc), token_key=pt.token_key, generation=pt.generation)
+            for suffix in (".json", ".st", ".ids"):
+                try:
+                    os.remove(self._point_path(pt.key, suffix))
+                except OSError:
+                    pass
+            try:
+                _fsync_dir(self.points_dir)
+            except OSError:
+                pass
+            print(f"[tensorfold] spill rank {self.rank}: writing {pt.key} failed: {exc!r}", flush=True)
+        finally:
+            job.small = None
+            with self.lock:
+                self.backlog -= job.size
+                self.host_pending -= job.host_bytes
+                self.inflight.discard(pt.key)
+                self.inflight.difference_update([h for _, _, h in job.new] + job.cut)
+                self.waiting.pop(pt.key, None)
+                self._ref(pt.blocks, -1)
+                self._gc(pt.blocks)
+            job.done.set()
+
+    # -- room ----------------------------------------------------------------------------------------------------------
+    def _ref(self, names, k: int) -> None:
+        """Lock held: points or waiting states naming ``names`` (+1 each, or -1)."""
+
+        for b in names:
+            v = self.refs.get(b, 0) + k
+            if v > 0:
+                self.refs[b] = v
+            else:
+                self.refs.pop(b, None)
+
+    def _gc(self, names) -> None:
+        """Lock held: of ``names``, the blocks nothing names any more (no point, waiting state, write in flight or
+        persist deciding) go."""
+
+        for b in set(names):
+            if b in self.have and b not in self.refs and b not in self.inflight and b not in self.pinned:
+                self._drop_block(b)
+
+    def _remove(self, key: str, why: str) -> None:
+        """Lock held: a point goes (its files), then the blocks only it named."""
+
+        pt = self.index.pop(key, None)
+        if pt is None:
+            return
+        self.version += 1
+        self.index_host_bytes -= pt.index_bytes
+        self._ref(pt.blocks, -1)
+        up = self.parent.pop(key, None)                     # its children's longest ancestor is now its parent
+        for k, v in self.parent.items():
+            if v == key:
+                self.parent[k] = up
+        self.small_on_disk -= pt.small_bytes
+        self._remember(key, "evicted", why, token_key=pt.token_key, generation=pt.generation,
+                       n=pt.n, state_bytes=pt.state_bytes, host_bytes=pt.host_bytes)
+        for suffix in (".json", ".st", ".ids"):
+            try:
+                os.remove(self._point_path(key, suffix))
+            except OSError:
+                pass
+        self.stats[why] += 1
+        self._gc(pt.blocks)
+
+    def _extends(self, p: Point, q: Point) -> bool:
+        """Whether ``p``'s ids extend ``q``'s (a strict prefix), by their block chains and q's tail."""
+
+        if q.n >= p.n:
+            return False
+        for x in (p, q):
+            if x.chain is None:
+                x.chain = _chain(x.ids, self.block)
+        k = len(q.chain)
+        return q.chain == p.chain[:k] and np.array_equal(p.ids[k * self.block:q.n], q.ids[k * self.block:])
+
+    def _parent_of(self, p: Point) -> str | None:
+        """Lock held: the longest point in the index ``p``'s ids extend."""
+
+        best = None
+        for q in self.index.values():
+            if q is not p and (best is None or q.n > best.n) and self._extends(p, q):
+                best = q
+        return None if best is None else best.key
+
+    def _adopt(self, pt: Point) -> None:
+        """Lock held: ``pt`` just entered the index: its parent, and the points it now stands between."""
+
+        self.parent[pt.key] = self._parent_of(pt)
+        for q in self.index.values():
+            if q is not pt and self._extends(q, pt):
+                cur = self.parent.get(q.key)
+                if cur is None or self.index[cur].n < pt.n:
+                    self.parent[q.key] = pt.key
+
+    def _trim_path(self, pt: Point) -> None:
+        """Lock held, after ``pt`` is written: on its conversation's path (its ancestors below a shared-prefix state)
+        the newest ``turns`` states stay, older ones go now (``trimmed_turns``). They free their small states only:
+        the states kept still name every block. Never a state being read or written; never a fork off the path."""
+
+        if self.turns <= 0 or pt.shared:
+            return
+        path, cur = [], pt.key
+        while cur is not None and cur in self.index and not self.index[cur].shared:
+            path.append(cur)
+            cur = self.parent.get(cur)
+        for k in path[self.turns:]:
+            if k not in self.reading and k not in self.inflight:
+                self._remove(k, "trimmed_turns")
+
+    def _conv(self, key: str, parent: dict) -> str | None:
+        """Lock held: the conversation of point ``key``: the topmost non-shared point on its path below a
+        shared-prefix one (None for a shared one)."""
+
+        if self.index[key].shared:
+            return None
+        top, cur = key, parent.get(key)
+        while cur is not None and not self.index[cur].shared:
+            top, cur = cur, parent.get(cur)
+        return top
+
+    def _tree(self) -> tuple[dict, dict]:
+        """Lock held: each point's parent (kept as points come and go) and its conversation."""
+
+        parent = dict(self.parent)
+        return parent, {k: self._conv(k, parent) for k in self.index}
+
+    def _victims(self, only: str | None = None) -> list[tuple[str, str]]:
+        """Lock held: (point, why) in eviction order (the module's docstring); ``only``: a conversation's own old turns
+        and forks (its quota)."""
+
+        parent, conv = self._tree()
+        children: dict[str, list[str]] = {}
+        for k, p in parent.items():
+            if p is not None:
+                children.setdefault(p, []).append(k)
+        groups: dict[str, list[str]] = {}
+        for k, c in conv.items():
+            if c is not None:
+                groups.setdefault(c, []).append(k)
+        turns, forks, whole = [], [], []
+        for c, keys in groups.items():
+            if only is not None and c != only:
+                continue
+            leaves = [k for k in keys if not [x for x in children.get(k, []) if conv.get(x) == c]]
+            newest = max(leaves or keys, key=lambda k: self.index[k].used)
+            path, cur = [], newest
+            while cur is not None and conv.get(cur) == c:
+                path.append(cur)
+                cur = parent[cur]
+            keep = set(path[:max(1, self.turns)])
+            on_path = set(path)
+            for k in keys:
+                if k in keep:
+                    continue
+                if k in on_path or k not in leaves:
+                    turns.append(k)
+                else:
+                    forks.append(k)
+            whole.append((max(self.index[k].used for k in keys), keys, newest, path))
+        by_used = lambda k: self.index[k].used
+        out = [(k, "pruned_turns") for k in sorted(turns, key=by_used)]
+        out += [(k, "pruned_forks") for k in sorted(forks, key=by_used)]
+        if only is not None:
+            return out
+        for _, keys, _, path in sorted(whole, key=lambda g: g[0]):
+            rest = [k for k in keys if k not in set(turns) | set(forks)]
+            out += [(k, "pruned_conversations") for k in sorted(rest, key=lambda k: -self.index[k].n)]
+        shared = [k for k, c in conv.items() if c is None]
+        out += [(k, "pruned_shared") for k in sorted(shared, key=lambda k: (self.index[k].used, -self.index[k].n))]
+        return out
+
+    def _make_room(self, nbytes: int, protect=frozenset()) -> None:
+        """Free at least ``nbytes`` (the cap's or the floor's shortfall), in the eviction order, never ``protect``."""
+
+        with self.lock:
+            target = self.stored() - nbytes
+            for key, why in self._victims():
+                if self.stored() <= target:
+                    return
+                if key in protect or key not in self.index or key in self.reading:
+                    continue
+                self._remove(key, why)
+
+    def _conv_bytes(self, keys) -> int:
+        """Lock held: bytes only ``keys``' points hold (their files, and blocks no other point names)."""
+
+        mine = set(keys)
+        others = {b for k, pt in self.index.items() if k not in mine for b in pt.blocks}
+        blocks = {b for k in mine for b in self.index[k].blocks if b not in others and b in self.have}
+        inos = {self.have[b][1] for b in blocks}
+        own = sum(self.inodes[i][0] for i in inos if i in self.inodes and self.inodes[i][1] <= blocks)
+        return own + sum(self.index[k].small_bytes for k in mine)
+
+    def _trim_own(self, pt: Point, need: int) -> None:
+        """A write of ``pt`` whose conversation holds more than its quota: its own old turns and forks go first."""
+
+        with self.lock:
+            if not self.index or pt.shared:
+                return
+            parent, conv = self._tree()
+            up = self._parent_of(pt)
+            c = None
+            while up is not None and not self.index[up].shared:
+                c, up = up, parent.get(up)
+            if c is None:                                   # its own conversation's first state: nothing to trim
+                return
+            c = conv.get(c)
+            keys = [k for k, v in conv.items() if v == c]
+            over = self._conv_bytes(keys) + need - int(self.quota * self.cap)
+            if over <= 0:
+                return
+            self.stats["quota_trims"] += 1
+            target = self.stored() - over
+            for key, why in self._victims(only=c):
+                if self.stored() <= target:
+                    break
+                if key in self.inflight or key in self.reading:
+                    continue
+                self._remove(key, why)
+
+    # -- read ----------------------------------------------------------------------------------------------------------
+    def candidates(self, prompt: Sequence[int], longer_than: int = 0, grid: int = 0, usable=None) -> list[Point]:
+        """All matching committed generations, allowing older-common-rank fallback.
+
+        Returning one longest token-only point is unsafe: the caller intersects
+        exact (token_key,generation) identities across ranks before loading.
+        """
+        arr = np.asarray(prompt, dtype=np.int64)
+        with self.lock:
+            points = sorted(self.index.values(), key=lambda p: (-p.n, -p.used, p.key))
+            return [pt for pt in points
+                    if pt.n > longer_than and pt.n <= len(arr)
+                    and (not grid or pt.n % grid == 0)
+                    and (pt.n != len(arr) or pt.head)
+                    and (usable is None or usable(pt)) and self.has(pt.key)
+                    and np.array_equal(arr[:pt.n], pt.ids)]
+
+    def best(self, prompt: Sequence[int], longer_than: int = 0, grid: int = 0, usable=None) -> Point | None:
+        points = self.candidates(prompt, longer_than, grid, usable)
+        return points[0] if points else None
+
+    def load_async(self, key: str, where) -> LoadJob:
+        with self.lock:
+            pt = self.index.get(key) if self.has(key) else None
+            lj = LoadJob(pt, where)
+            if pt is None:
+                lj.error = FileNotFoundError(f"rank {self.rank} has no exact-generation prompt {key}")
+                lj.done.set()
+                return lj
+            reserve = self._small_read_bytes(pt)
+            if self.read_host_pending + reserve > self.read_host_cap or self.active_reads >= 64:
+                lj.error = Backpressure("bounded small-state read staging capacity exhausted")
+                lj.done.set()
+                return lj
+            self.read_host_pending += reserve
+            self.active_reads += 1
+            lj.host_reserved = reserve
+            self.reading.add(key)
+        self.touch(key)
+        self.ring()
+        self.reads.put(lj)
+        return lj
+
+    def release_load_state(self, lj: LoadJob) -> None:
+        """Caller after GPU state copy/discard; cancellation releases after actual I/O ends."""
+        with self.lock:
+            if lj.host_released or not lj.host_reserved:
+                return
+            if not lj.done.is_set():
+                return
+            lj.host_released = True
+            self.read_host_pending -= lj.host_reserved
+            self.active_reads -= 1
+            lj.small = None
+            if hasattr(lj, "raw"):
+                lj.raw = None
+
+    @staticmethod
+    @contextlib.contextmanager
+    def moving(lj: LoadJob):
+        """The engine, around a move of the extent ``lj`` reads into. Nothing to hold: its blocks are copied on the
+        engine's own stream between rounds (``step``), so the move's copy comes after the copies before it and before
+        the ones after it, which find the extent at its new base."""
+
+        yield
+
+    def _read_block(self, h: str, crc: int, buf: torch.Tensor, nb: int) -> None:
+        """A reader thread: block ``h`` into pinned ``buf`` (O_DIRECT where it works), checked against its CRC-32."""
+
+        path = self._block_path(h)
+        direct = self.direct
+        fd = -1
+        if direct:
+            try:
+                fd = os.open(path, os.O_RDONLY | os.O_DIRECT)
+            except OSError as exc:
+                if exc.errno != errno.EINVAL:
+                    raise
+                direct = False
+        if fd < 0:
+            fd = os.open(path, os.O_RDONLY)
+        try:
+            if os.fstat(fd).st_size != nb:
+                raise Corrupt(f"{h}: {os.fstat(fd).st_size} bytes, the planes take {nb}")
+            mv = memoryview(buf.numpy())[:_up(nb) if direct else nb]
+            got = 0
+            while got < nb:
+                k = os.preadv(fd, [mv[got:]], got)
+                if k <= 0:
+                    raise EOFError(f"{h}: short read")
+                got += k
+                if direct and got < nb and got % _sp.ALIGN:     # (a partial O_DIRECT read: the rest, buffered)
+                    os.close(fd)
+                    fd = os.open(path, os.O_RDONLY)
+                    direct = False
+                    mv = mv[:nb]
+            if zlib.crc32(mv[:nb]) != crc:
+                raise Corrupt(f"{h}: its CRC-32 does not match its point")
+            try:
+                os.posix_fadvise(fd, 0, 0, os.POSIX_FADV_DONTNEED)
+            except (AttributeError, OSError):
+                pass
+        finally:
+            os.close(fd)
+
+    def _read_loop(self) -> None:
+        while True:
+            lj = self.reads.get()
+            try:
+                self._read(lj)
+            except BaseException as exc:                    # noqa: BLE001  (the reader never dies)
+                lj.error = exc
+            with self.lock:
+                self.reading.discard(lj.point.key)
+            with lj.cond:
+                lj.done.set()
+                lj.cond.notify_all()
+            if lj.stop:
+                self.release_load_state(lj)
+            lj = None
+
+    def _slot(self, lj: LoadJob) -> int | None:
+        """The reader: a free pinned slot for ``lj``'s next block (the engine frees one once its copy out of it ended),
+        or None once the engine gave up on ``lj``."""
+
+        while not lj.stop:
+            try:
+                return self.free_reads.get(timeout=0.2)
+            except queue.Empty:
+                continue
+        return None
+
+    def _read(self, lj: LoadJob) -> None:
+        """The reader: ``lj``'s blocks into pinned slots, in order, as slots come free (several read at once on the
+        reader pool, each checked against its CRC-32), then its small state. Issues no CUDA work."""
+
+        pt = lj.point
+        job = self.waiting.get(pt.key)
+        if job is not None and not job.done.wait(LOAD_WAIT_S):   # (a point is only read once complete; safety)
+            raise OSError(f"{pt.key}: its write did not end in time")
+        if not self.slots or not self.read_slots:
+            raise RuntimeError("read ring must be initialized on the engine thread")
+        spans = list(block_hashes(pt.ids, self.block, pt.lineage))
+        if [h for _, _, h in spans] != pt.blocks:
+            raise Corrupt(f"{pt.key}: its block list does not match its ids and lineage")
+        for i, (s, e, h) in enumerate(spans):
+            b = self._slot(lj)
+            if b is None:
+                return
+            nb = _span_bytes(self.planes, s, e)
+            fut = self._readers.submit(self._read_block, h, pt.crcs[i], self.read_slots[b], nb)
+            with lj.cond:
+                if lj.stop:
+                    fut.add_done_callback(lambda _f, slot=b: self.free_reads.put(slot))
+                    return
+                lj.queued[i] = (b, nb, fut, s, e, h)
+                lj.cond.notify_all()
+        if not lj.stop:
+            self._read_small(lj)
+
+    def _read_small(self, lj) -> None:
+        pt = lj.point
+        t1 = time.perf_counter()
+        path = self._point_path(pt.key, ".st")
+        size = os.path.getsize(path)
+        if size > pt.host_bytes or size < 8:
+            raise Corrupt("small-state file exceeds declared bounded geometry")
+        raw, got = self._read_file(path, size)
+        if got != size or zlib.crc32(raw) != pt.small_crc:
+            self.stats["crc_failed"] += 1
+            raise Corrupt(f"{pt.key}: its small state does not match its CRC-32")
+        header, offset = _sp._parse_header(bytes(raw[:8 + struct.unpack("<Q", raw[:8])[0]]))
+        declared = sum(max(0, int(v["data_offsets"][1]) - int(v["data_offsets"][0]))
+                       for k, v in header.items() if k != "__metadata__")
+        if declared > pt.state_bytes:
+            raise Corrupt("small-state tensor payload exceeds pre-load state reservation")
+        lj.small = _small_read(raw, self.classes)
+        lj.raw = raw                                        # (the small state's tensors are views of it)
+        self.stats["load_small_s"] += time.perf_counter() - t1
+
+    # -- the engine's side of a read ---------------------------------------------------------------------------------
+    def _recycle(self, wait: bool = False) -> None:
+        """The engine: slots whose copy out ended go back to the reader (``wait``: every one, waiting for them)."""
+
+        keep = []
+        for b, ev in self.read_events:
+            if ev is None or wait or ev.query():
+                if ev is not None and wait:
+                    ev.synchronize()
+                self.free_reads.put(b)
+            else:
+                keep.append((b, ev))
+        self.read_events = keep
+
+    def settle(self) -> None:
+        """The engine (every rank), in a decode round once its verify pass is queued: every read slot copied out by
+        the last step (on this stream, before the round's work) back to the reader, waiting for the newest of those
+        copies while the GPU runs the queued pass. Without it a step frees only the slots the step before copied out,
+        so beside a decoding stream a slot turns every second round."""
+
+        evs = getattr(self, "read_events", None)        # (made with the slots, at the first read or write)
+        if not evs:
+            return
+        last = next((ev for _, ev in reversed(evs) if ev is not None), None)
+        if last is not None:
+            last.synchronize()                          # (one stream: the copies before it are done too)
+        for b, _ in evs:
+            self.free_reads.put(b)
+        self.read_events = []
+
+    @staticmethod
+    def ready_prefix(lj: LoadJob) -> dict:
+        """Completed contiguous read futures only; never performs a wait or copy."""
+        with lj.cond:
+            end = lj.next
+            while end in lj.queued and lj.queued[end][2].done():
+                future = lj.queued[end][2]
+                if future.exception() is not None:
+                    lj.error = future.exception()
+                    break
+                end += 1
+            return {"blocks": end, "complete": lj.done.is_set() and lj.small is not None and end == lj.total,
+                    "error": None if lj.error is None else repr(lj.error)}
+
+    ready_upto = ready_prefix
+
+    def step_ready(self, lj: LoadJob, upto: int) -> int:
+        """Finite copies of an already completed all-rank agreed prefix; zero I/O waits."""
+        if lj.stop or lj.error is not None:
+            raise lj.error or RuntimeError("cancelled load")
+        ready = self.ready_prefix(lj)
+        if ready["error"] is not None:
+            raise lj.error
+        end = int(upto)
+        if end < lj.next or end > ready["blocks"]:
+            raise Backpressure("LOADPART exceeds completed contiguous read prefix")
+        self._recycle()
+        count = 0
+        while lj.next < end:
+            with lj.cond:
+                b, nb, future, start, stop, name = lj.queued.pop(lj.next)
+            if not future.done():
+                raise RuntimeError("completed read future regressed")
+            try:
+                future.result()  # proven done; no I/O wait
+            except BaseException as exc:
+                self.free_reads.put(b)
+                lj.error = exc
+                lj.stop = True
+                raise
+            self._copy_in(lj, self.read_slots[b], start, stop)
+            event = None
+            if torch.cuda.is_available() and self.read_slots[b].is_pinned():
+                event = torch.cuda.Event()
+                event.record(torch.cuda.current_stream())
+            self.read_events.append((b, event))
+            lj.next += 1
+            count += 1
+            self.stats["loaded_bytes"] += nb
+        return count
+
+    def finish_ready(self, lj: LoadJob):
+        if lj.error is not None:
+            raise lj.error
+        ready = self.ready_prefix(lj)
+        if not ready["complete"] or lj.next != lj.total or lj.stop:
+            raise Backpressure("LOADED requires completed rows and fixed state")
+        if not lj.finished:
+            lj.finished = True
+            dt = time.perf_counter() - lj.t0
+            self.stats["loaded"] += 1
+            self.stats["loaded_tokens"] += lj.point.n
+            self.stats["load_s"] += dt
+            self.restore_ms.append(dt * 1000.0)
+            if len(self.restore_ms) > 4096:
+                del self.restore_ms[:2048]
+        return lj.small, lj.point
+
+    def cancel_load(self, lj: LoadJob, why: str = "coordinated_load_abort") -> None:
+        self.stop_load(lj, why)
+
+    def step(self, lj: LoadJob, upto: int | None = None, budget: float | None = None) -> int:
+        """The engine, between rounds (either rank): ``lj``'s next blocks into its extent, at its base now, on the
+        current stream, in order. Without ``upto``: only blocks read already, for at most ``budget`` seconds; with it:
+        every block before ``upto``, waiting for their reads. A block whose read failed fails the read (``error``) and
+        stops it. The blocks copied."""
+
+        self._recycle()
+        end = lj.total if upto is None else min(int(upto), lj.total)
+        t, n = time.perf_counter(), 0
+        while lj.next < end and lj.error is None:
+            i = lj.next
+            with lj.cond:
+                if upto is None and not (i in lj.queued and lj.queued[i][2].done()):
+                    break
+                while i not in lj.queued and lj.error is None and not lj.done.is_set():
+                    if budget is not None and time.perf_counter() - t >= budget:
+                        return n
+                    if self.read_events:                    # the slots this step's own copies used: back to the reader,
+                        self._recycle(wait=True)            # or it waits for one and block i is never read
+                    lj.cond.wait(min(0.05, max(0.0, budget - (time.perf_counter() - t))) if budget is not None else 0.05)
+                item = lj.queued.pop(i, None)
+            if item is None:
+                if lj.error is None:
+                    lj.error = OSError(f"{lj.point.key}: its read ended before block {i}")
+                break
+            b, nb, fut, s, e, h = item
+            try:
+                fut.result(timeout=None if budget is None else max(0.0, budget - (time.perf_counter() - t)))
+            except Exception as exc:
+                if isinstance(exc, FileNotFoundError):     # this name is gone: its links' bytes are not in question
+                    lj.lost.add(h)
+                elif isinstance(exc, (Corrupt, EOFError)):  # damaged bytes, not a passing I/O error
+                    lj.bad.add(h)
+                if isinstance(exc, Corrupt):
+                    self.stats["crc_failed"] += 1
+                lj.error = exc
+                if fut.done():
+                    self.free_reads.put(b)
+                else:
+                    fut.add_done_callback(lambda _f, slot=b: self.free_reads.put(slot))
+                break
+            self._copy_in(lj, self.read_slots[b], s, e)
+            ev = None
+            if torch.cuda.is_available() and self.read_slots[b].is_pinned():
+                ev = torch.cuda.Event()
+                ev.record(torch.cuda.current_stream())
+            self.read_events.append((b, ev))
+            lj.next += 1
+            n += 1
+            self.stats["loaded_bytes"] += nb
+            if upto is None and budget is not None and time.perf_counter() - t >= budget:
+                break
+        if lj.error is not None:
+            lj.stop = True
+        return n
+
+    def _copy_in(self, lj: LoadJob, src: torch.Tensor, s: int, e: int) -> None:
+        """The engine: one block's rows from pinned ``src`` into ``lj``'s extent at its base now (current stream)."""
+
+        stream = torch.cuda.current_stream() if torch.cuda.is_available() and src.is_pinned() else None
+        base = lj.where.base
+        at = 0
+        for p in self.planes:
+            a, z = _rows(p, s, e)
+            dst = p.tensor[base // p.div + a:base // p.div + z]
+            k = dst.numel() * dst.element_size()
+            v = dst.reshape(-1).view(torch.uint8)
+            if p.spanned:
+                if lj.stage is None:
+                    lj.stage = _sp._stage(self.planes[0].tensor.device, stream)
+                _sp._by_kernel(v, src[at:at + k], lj.stage, stream)
+            else:
+                v.copy_(src[at:at + k], non_blocking=stream is not None)
+            at += k
+
+    def stop_load(self, lj: LoadJob, why: str) -> None:
+        if lj.error is None:
+            lj.error = OSError(f"{lj.point.key if lj.point is not None else '?'}: {why}")
+        with lj.cond:
+            lj.stop = True
+            lj.cond.notify_all()
+        self._settle(lj)
+        if lj.done.is_set():
+            self.release_load_state(lj)
+
+    def _settle(self, lj: LoadJob) -> None:
+        # Pending reads retain their finite slots until their actual I/O ends.
+        # Cancellation never recycles a slot still being filled and never waits.
+        with lj.cond:
+            left, lj.queued = list(lj.queued.values()), {}
+        for item in left:
+            future, slot = item[2], item[0]
+            future.add_done_callback(lambda _f, b=slot: self.free_reads.put(b))
+
+    def _read_file(self, path: str, size: int):
+        """A whole file: O_DIRECT into an aligned buffer where it works, else buffered; its pages dropped after. (The
+        bytes, as a buffer the small state's tensors view, and how many were read.)"""
+
+        fd, direct = -1, False
+        if self.small_direct:
+            try:
+                fd, direct = os.open(path, os.O_RDONLY | os.O_DIRECT), True
+            except OSError as exc:
+                if exc.errno != errno.EINVAL:
+                    raise
+        if fd < 0:
+            fd = os.open(path, os.O_RDONLY)
+        try:
+            buf = _aligned_buffer(size) if direct else np.empty(size, dtype=np.uint8)
+            mv = memoryview(buf)
+            got = 0
+            while got < size:
+                k = os.preadv(fd, [mv[got:]], got)
+                if k <= 0:
+                    break
+                got += k
+                if direct and got < size and got % _sp.ALIGN:   # (a partial O_DIRECT read: the rest, buffered)
+                    os.close(fd)
+                    fd, direct = os.open(path, os.O_RDONLY), False
+            _drop_cache(fd)
